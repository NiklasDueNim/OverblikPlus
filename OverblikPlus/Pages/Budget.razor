@page "/budget"
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Models.Dtos.Budget
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.Components.Shared
@using OverblikPlus.Components
@inject IBudgetService BudgetService
@inject CustomAuthStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@using Microsoft.JSInterop
@inherits BasePage

<h3>Budget</h3>

<AlertMessage Message="@ErrorMessage" Type="AlertType.Error" MessageChanged="@((string? msg) => ErrorMessage = msg)" />
<AlertMessage Message="@SuccessMessage" Type="AlertType.Success" MessageChanged="@((string? msg) => SuccessMessage = msg)" />

@if (IsLoading)
{
    <LoadingSpinner Text="Henter budgetposter..." />
}
else
{
    <EditForm Model="@newBudget" OnValidSubmit="@AddBudget">
        <DataAnnotationsValidator/>
        <ValidationSummary/>

        <h4>Tilføj ny post</h4>

        <div class="mb-3">
            <label for="activity" class="form-label">Aktivitet:</label>
            <input id="activity" type="text" class="form-control" @bind="newBudget.Activity"/>
        </div>

        <div class="mb-3">
            <label for="voucher" class="form-label">Bilag:</label>
            <InputFile id="voucher" class="form-control" OnChange="UploadVoucher"/>
            @if (!string.IsNullOrWhiteSpace(newBudget.Voucher))
            {
                <small class="text-success d-block mt-1">✓ Bilag uploaded</small>
            }
        </div>

        <div class="mb-3">
            <label for="date" class="form-label">Dato:</label>
            <input id="date" type="date" class="form-control" @bind="newBudget.Date"/>
        </div>

        <div class="row">
            <div class="col">
                <label for="moneyIn" class="form-label">Penge ind:</label>
                <input id="moneyIn" type="number" step="0.01" class="form-control" @bind="newBudget.MoneyIn"/>
            </div>
            <div class="col">
                <label for="moneyOut" class="form-label">Penge ud:</label>
                <input id="moneyOut" type="number" step="0.01" class="form-control" @bind="newBudget.MoneyOut"/>
            </div>
        </div>

        <div class="mb-3">
            <label for="note" class="form-label">Note:</label>
            <textarea id="note" class="form-control" @bind="newBudget.Note" rows="3"></textarea>
        </div>

        <button class="btn btn-primary mt-3" type="submit">@(isEditMode ? "Opdater" : "Tilføj")</button>
        @if (isEditMode)
        {
            <button class="btn btn-secondary mt-3 ms-2" type="button" @onclick="CancelEdit">Annuller</button>
        }
    </EditForm>

    <hr/>

    <h4>Budgetposter</h4>
    <table class="table table-bordered">
        <thead>
        <tr>
            <th>Aktivitet</th>
            <th>Bilag</th>
            <th>Dato</th>
            <th class="text-end">Penge ind</th>
            <th class="text-end">Penge ud</th>
            <th class="text-end">I alt</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in budgets.OrderByDescending(b => b.Date))
        {
            <tr>
                <td>@item.Activity</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(item.Voucher))
                    {
                        var voucherUrl = FixVoucherUrl(item.Voucher);
                        var isImage = IsImageUrl(voucherUrl);
                        if (isImage)
                        {
                            <img src="@voucherUrl" alt="Bilag" class="voucher-thumbnail" @onclick="() => ShowVoucherModal(item.Voucher)" style="cursor: pointer;" title="Klik for at se større" 
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';" />
                            <a href="@voucherUrl" target="_blank" class="btn btn-sm btn-link p-0" style="display: none;">Se bilag</a>
                        }
                        else
                        {
                            <a href="@voucherUrl" target="_blank" class="btn btn-sm btn-link p-0" title="Klik for at se bilag">
                                📎 Se bilag
                            </a>
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>@item.Date.ToShortDateString()</td>
                <td class="text-end">@item.MoneyIn.ToString("N2")</td>
                <td class="text-end">@item.MoneyOut.ToString("N2")</td>
                <td class="text-end">@((item.MoneyIn - item.MoneyOut).ToString("N2"))</td>
                <td class="text-center">
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="() => EditBudget(item)">
                        Rediger
                    </button>
                    <button class="btn btn-sm btn-danger ms-2"
                            @onclick="() => DeleteBudget(item.Id)">
                        Slet
                    </button>
                </td>
            </tr>
        }
        </tbody>
    </table>

    <p class="fw-bold">
        Total balance: @TotalBalance
    </p>
}

<!-- Modal for viewing voucher image -->
@if (showVoucherModal && !string.IsNullOrEmpty(selectedVoucherUrl))
{
    <div class="modal-backdrop show" style="opacity: 0.5;"></div>
    <div class="modal show d-block" tabindex="-1" role="dialog" style="z-index: 1050;">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Bilag</h5>
                    <button type="button" class="btn-close" aria-label="Luk" @onclick="CloseVoucherModal"></button>
                </div>
                <div class="modal-body text-center">
                    <img src="@FixVoucherUrl(selectedVoucherUrl)" alt="Bilag" class="img-fluid" style="max-height: 70vh;" />
                </div>
                <div class="modal-footer">
                    <a href="@FixVoucherUrl(selectedVoucherUrl)" target="_blank" class="btn btn-primary">Åbn i ny fane</a>
                    <button type="button" class="btn btn-secondary" @onclick="CloseVoucherModal">Luk</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<BudgetDto> budgets = new();
    private BudgetDto newBudget = new() { Date = DateTime.Today };
    private bool isEditMode = false;
    private Guid? editingId = null;
    private bool showVoucherModal = false;
    private string? selectedVoucherUrl = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadBudgets();
    }

    private async Task LoadBudgets()
    {
        SetLoading(true);
        ClearMessages();
        
        try
        {
            budgets = await BudgetService.GetAllBudgetsAsync();
            LogInfo($"Loaded {budgets.Count} budget items");
        }
        catch (Exception ex)
        {
            LogError("Error loading budgets", ex);
            SetError($"Fejl ved hentning af budget: {ex.Message}");
        }
        finally
        {
            SetLoading(false);
        }
    }

    private async Task AddBudget()
    {
        SetLoading(true);
        ClearMessages();
        
        try
        {
            if (isEditMode && editingId.HasValue)
            {
                var updatedBudget = await BudgetService.UpdateBudgetAsync(editingId.Value, newBudget);
                if (updatedBudget != null)
                {
                    SetSuccess("Budgetpost er opdateret.");
                    await LoadBudgets();
                    CancelEdit();
                }
                else
                {
                    SetError("Fejl ved opdatering af budgetpost.");
                }
            }
            else
            {
                // Create new budget
                LogInfo($"Creating budget with voucher: {newBudget.Voucher}");
                var createdBudget = await BudgetService.CreateBudgetAsync(newBudget);
                if (createdBudget != null)
                {
                    SetSuccess("Budgetpost er oprettet.");
                    LogInfo($"Budget created successfully. ID: {createdBudget.Id}");
                    await LoadBudgets();
                    newBudget = new BudgetDto { Date = DateTime.Today };
                }
                else
                {
                    SetError("Fejl ved oprettelse af budgetpost.");
                }
            }
        }
        catch (Exception ex)
        {
            LogError("Error in AddBudget", ex);
            SetError($"Fejl: {ex.Message}");
        }
        finally
        {
            SetLoading(false);
        }
    }

    private async Task UploadVoucher(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // 10MB max
                var fileUrl = await BudgetService.UploadVoucherAsync(stream, file.Name);
                if (!string.IsNullOrWhiteSpace(fileUrl))
                {
                    newBudget.Voucher = fileUrl;
                    SetSuccess("Bilag er uploaded.");
                    LogInfo($"Voucher uploaded: {fileUrl}");
                    StateHasChanged();
                }
                else
                {
                    SetError("Fejl ved upload af bilag - ingen URL returneret.");
                }
            }
            catch (Exception ex)
            {
                LogError("Error uploading voucher", ex);
                SetError($"Fejl ved upload af bilag: {ex.Message}");
            }
        }
    }


    private decimal TotalBalance => budgets.Sum(b => b.MoneyIn - b.MoneyOut);

    private void EditBudget(BudgetDto item)
    {
        isEditMode = true;
        editingId = item.Id;
        newBudget = new BudgetDto
        {
            Id = item.Id,
            UserId = item.UserId,
            Activity = item.Activity,
            Voucher = item.Voucher,
            MoneyIn = item.MoneyIn,
            MoneyOut = item.MoneyOut,
            Date = item.Date,
            Note = item.Note
        };
    }

    private void CancelEdit()
    {
        isEditMode = false;
        editingId = null;
        newBudget = new BudgetDto { Date = DateTime.Today };
    }

    private async Task DeleteBudget(Guid id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Er du sikker på, at du vil slette denne budgetpost?");
        if (!confirmed)
        {
            return;
        }

        SetLoading(true);
        ClearMessages();
        
        try
        {
            var success = await BudgetService.DeleteBudgetAsync(id);
            if (success)
            {
                SetSuccess("Budgetpost er slettet.");
                await LoadBudgets();
            }
            else
            {
                SetError("Fejl ved sletning af budgetpost.");
            }
        }
        catch (Exception ex)
        {
            LogError("Error deleting budget", ex);
            SetError($"Fejl ved sletning: {ex.Message}");
        }
        finally
        {
            SetLoading(false);
        }
    }

    private string FixVoucherUrl(string voucherUrl)
    {
        // The backend now returns browser-reachable URLs (an API proxy in development),
        // so no client-side rewriting is needed.
        return voucherUrl ?? "";
    }

    private bool IsImageUrl(string url)
    {
        if (string.IsNullOrEmpty(url))
            return false;

        var lowerUrl = url.ToLower();
        return lowerUrl.EndsWith(".jpg") || 
               lowerUrl.EndsWith(".jpeg") || 
               lowerUrl.EndsWith(".png") || 
               lowerUrl.EndsWith(".gif") || 
               lowerUrl.EndsWith(".webp") ||
               lowerUrl.EndsWith(".bmp") ||
               lowerUrl.Contains("/api/Image/");
    }

    private void ShowVoucherModal(string voucherUrl)
    {
        selectedVoucherUrl = voucherUrl;
        showVoucherModal = true;
    }

    private void CloseVoucherModal()
    {
        showVoucherModal = false;
        selectedVoucherUrl = null;
    }
}

<style>
    .voucher-thumbnail {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border: 1px solid #ddd;
        border-radius: 4px;
        cursor: pointer;
        transition: transform 0.2s;
    }

    .voucher-thumbnail:hover {
        transform: scale(1.1);
        border-color: #007bff;
    }
</style>