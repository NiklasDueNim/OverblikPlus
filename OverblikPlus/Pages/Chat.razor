@page "/chatTest"
@using Microsoft.AspNetCore.SignalR.Client
@using Blazored.LocalStorage
@inject NavigationManager NavigationManager
@inject ILocalStorageService localStorage
@inject IConfiguration Configuration
@implements IAsyncDisposable

<div class="chat-container">
    <div class="chat-header">
        <h3>
            <i class="fas fa-comments"></i>
            Beskeder
        </h3>
        <span class="connection-status @(IsConnected ? "connected" : "disconnected")">
            <i class="fas fa-circle"></i>
            @(IsConnected ? "Online" : "Offline")
        </span>
    </div>

    <div class="messages-container">
        @if (messages.Count == 0)
        {
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <p>Ingen beskeder endnu</p>
                <small>Send en besked for at starte en samtale</small>
            </div>
        }
        else
        {
            @foreach (var message in messages)
            {
                <div class="message-bubble @GetMessageClass(message)">
                    <div class="message-content">
                        <span class="message-sender">@GetSender(message)</span>
                        <p class="message-text">@GetMessageText(message)</p>
                        <span class="message-time">@DateTime.Now.ToString("HH:mm")</span>
                    </div>
                </div>
            }
        }
    </div>

    <div class="chat-input-container">
        <input 
            type="text" 
            class="chat-input" 
            placeholder="Skriv en besked..." 
            @bind="messageInput"
            @onkeypress="HandleKeyPress" />
        <button class="btn-send" @onclick="Send" disabled="@(!IsConnected || string.IsNullOrWhiteSpace(messageInput))">
            <i class="fas fa-paper-plane"></i>
        </button>
        <button class="btn-delete" @onclick="DeleteMessages" title="Slet alle beskeder">
            <i class="fas fa-trash"></i>
        </button>
    </div>
</div>

@code {
    private HubConnection hubConnection;
    private List<string> messages = new List<string>();
    private string? messageInput;
    private const string MessagesKey = "chatMessages";

    public static event Action OnMessageSent;

    protected override async Task OnInitializedAsync()
    {
        messages = await localStorage.GetItemAsync<List<string>>(MessagesKey) ?? new List<string>();

        var userApiBaseUrl = Configuration["USER_API_BASE_URL"];
        
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl($"{userApiBaseUrl}/chatHub")
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<string, string>("ReceiveMessage", (user, message) =>
            {
                var formattedMessage = $"{user}: {message}";
                messages.Add(formattedMessage);
                InvokeAsync(StateHasChanged);
                SaveMessages();
            });

            await hubConnection.StartAsync();
            Console.WriteLine("Connected to chat hub");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"SignalR not available: {ex.Message}");
            Console.WriteLine("Messages will be saved locally only.");
        }
    }

    private async Task Send()
    {
        if (!string.IsNullOrWhiteSpace(messageInput))
        {
            try
            {
                if (hubConnection?.State == HubConnectionState.Connected)
                {
                    await hubConnection.SendAsync("SendMessage", "User", messageInput);
                }
                else
                {
                    var formattedMessage = $"User: {messageInput}";
                    messages.Add(formattedMessage);
                    await SaveMessages();
                    Console.WriteLine("📝 Message saved locally (SignalR not connected)");
                }
                
                messageInput = string.Empty;
                OnMessageSent?.Invoke();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error sending message: {ex.Message}");
            }
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(messageInput))
        {
            await Send();
        }
    }

    private async Task SaveMessages()
    {
        await localStorage.SetItemAsync(MessagesKey, messages);
    }

    public bool IsConnected =>
        true; // Always show as connected since we can save locally

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
    
    private async Task DeleteMessages()
    {
        messages.Clear();
        await localStorage.SetItemAsync(MessagesKey, messages);
        StateHasChanged();
    }

    private string GetMessageClass(string message)
    {
        return message.StartsWith("User:") ? "message-sent" : "message-received";
    }

    private string GetSender(string message)
    {
        var parts = message.Split(':');
        return parts.Length > 0 ? parts[0].Trim() : "Unknown";
    }

    private string GetMessageText(string message)
    {
        var parts = message.Split(':', 2);
        return parts.Length > 1 ? parts[1].Trim() : message;
    }
}
