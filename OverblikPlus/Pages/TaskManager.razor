@page "/TaskManager"
@using AutoMapper
@using Newtonsoft.Json
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Common
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.Components
@using OverblikPlus.Components.Shared
@using OverblikPlus.Constants
@using OverblikPlus.Models.Dtos.Tasks
@using OverblikPlus.Models.Dtos.TaskSteps
@using OverblikPlus.Models.Dtos.User
@using OverblikPlus.Models.FormModels
@inject ITaskService TaskService
@inject IUserService UserService
@inject ITaskStepService TaskStepService
@inject IMapper Mapper
@inject CustomAuthStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@inherits BasePage

<div class="container mt-4">
    <h3 class="mb-4">Administrer Opgaver</h3>

    <AlertMessage Message="@ErrorMessage" Type="AlertType.Error" MessageChanged="@((string? msg) => ErrorMessage = msg)" />
    <AlertMessage Message="@SuccessMessage" Type="AlertType.Success" MessageChanged="@((string? msg) => SuccessMessage = msg)" />

    <button class="btn btn-success mb-3" @onclick="CreateTask">Opret Ny Opgave</button>

    @if (isTaskFormVisible)
    {
        <div id="task-form-container">
            <TaskForm Title="@(isEditMode ? "Rediger Opgave" : "Opret Ny Opgave")"
                      Task="taskFormModel"
                      Users="users"
                      OnSave="SaveTask"
                      OnCancel="CancelTaskForm"/>
        </div>
    }

    <hr/>

    <TaskOverviewComponent Tasks="Tasks"
                           OnEditTask="EditTask"
                           OnDeleteTask="DeleteTask"
                           OnAddStep="AddStep"
                           OnEditStep="EditStep"
                           OnDeleteStep="OnDeleteStepHandler"/>

    @if (isStepFormVisible)
    {
        <div class="modal-backdrop" tabindex="-1" role="dialog" aria-labelledby="addStepModalLabel" aria-hidden="true" style="background-color: rgba(0, 0, 0, 0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">@((isEditStepMode ? "Rediger Trin" : "Tilføj Trin"))</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CancelStepForm"></button>
                    </div>
                    <div class="modal-body">
                        <!-- Formular for trin -->
                        <div class="mb-3">
                            <label for="stepText" class="form-label">Beskrivelse:</label>
                            <textarea id="stepText" @bind="currentStep.Text" class="form-control"></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="stepImage" class="form-label">Billede:</label>
                            <InputFile OnChange="HandleImageUpload" class="form-control"/>
                            @if (!string.IsNullOrEmpty(currentStep.ImageBase64))
                            {
                                <img src="data:image/png;base64,@currentStep.ImageBase64" class="fixed-size-image"/>
                            }
                        </div>
                        <div class="mb-3">
                            <label for="requiresQrCode" class="form-label">Kræver QR-kode scanning:</label>
                            <input type="checkbox" id="requiresQrCode" @bind="currentStep.RequiresQrCodeScan" class="form-check-input"/>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelStepForm">Annuller</button>
                        <button type="button" class="btn btn-primary" @onclick="SaveStep">Gem</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ReadTaskDto> Tasks { get; set; } = new List<ReadTaskDto>();
    private List<ReadUserDto> users = new List<ReadUserDto>();
    private TaskFormModel taskFormModel = new TaskFormModel();
    private bool isEditMode = false;
    private bool isTaskFormVisible = false;
    private bool isStepFormVisible = false;
    private TaskStepFormModel currentStep = new TaskStepFormModel();
    private bool isEditStepMode = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
        await LoadUsers();
    }

    private async Task LoadTasks()
    {
        SetLoading(true);
        ClearMessages();
        
        try
        {
            var role = AuthStateProvider.GetRole();
            Result<List<ReadTaskDto>> result;

            if (Roles.IsAdminOrStaff(role))
            {
                result = await TaskService.GetAllTasks();
            }
            else if (role == Roles.User)
            {
                var currentUserId = AuthStateProvider.GetUserId();
                result = await TaskService.GetTasksForUserAsync(currentUserId);
            }
            else
            {
                Tasks = new List<ReadTaskDto>();
                SetLoading(false);
                return;
            }

            if (result.Success && result.Data != null)
            {
                Tasks = result.Data;
                LogInfo($"Loaded {Tasks.Count} tasks");
            }
            else
            {
                SetError(result.Error ?? "Kunne ikke hente opgaver.");
                Tasks = new List<ReadTaskDto>();
            }
        }
        catch (Exception ex)
        {
            LogError("Error loading tasks", ex);
            SetError($"Fejl ved indlæsning af opgaver: {ex.Message}");
            Tasks = new List<ReadTaskDto>();
        }
        finally
        {
            SetLoading(false);
        }
    }


    private async Task LoadUsers()
    {
        try
        {
            var result = await UserService.GetAllUsers();
            if (result.Success && result.Data != null)
            {
                users = result.Data.ToList();
                LogInfo($"Loaded {users.Count} users");
            }
            else
            {
                LogWarning($"Failed to load users: {result.Error}");
                users = new List<ReadUserDto>();
            }
        }
        catch (Exception ex)
        {
            LogError("Error loading users", ex);
            users = new List<ReadUserDto>();
        }
    }

    private void CreateTask()
    {
        taskFormModel = new TaskFormModel();
        taskFormModel.UserId = AuthStateProvider.GetUserId();
        isEditMode = false;
        isTaskFormVisible = true;
        StateHasChanged();
    }

    private async Task EditTask(ReadTaskDto task)
    {
        try
        {
            LogInfo($"EditTask called for task ID: {task.Id}, Name: {task.Name}");
            
            taskFormModel = Mapper.Map<TaskFormModel>(task);
            
            // Sikrer at alle properties er sat korrekt
            if (string.IsNullOrEmpty(taskFormModel.RecurrenceType))
            {
                taskFormModel.RecurrenceType = task.RecurrenceType ?? "None";
            }
            if (taskFormModel.StartDate == default)
            {
                taskFormModel.StartDate = task.StartDate;
            }
            
            LogInfo($"TaskFormModel mapped - Id: {taskFormModel.Id}, Name: {taskFormModel.Name}, EditMode: {isEditMode}");
            
            isEditMode = true;
            isTaskFormVisible = true;
            
            LogInfo($"Form visibility set to: {isTaskFormVisible}, EditMode: {isEditMode}");
            
            StateHasChanged();
            
            // Scroll til formularen efter kort ventetid
            try
            {
                await Task.Delay(100);
                await JSRuntime.InvokeVoidAsync("scrollToElement", "task-form-container");
            }
            catch (Exception jsEx)
            {
                // Ignorer JS fejl - scroll er ikke kritisk
                LogWarning($"Could not scroll to form: {jsEx.Message}");
            }
        }
        catch (Exception ex)
        {
            LogError("Error in EditTask", ex);
            SetError($"Fejl ved redigering: {ex.Message}");
        }
    }

    private bool isSaving = false;

    private async Task SaveTask()
    {
        if (isSaving)
        {
            Console.WriteLine("SaveTask er allerede i gang - ignorerer ekstra kald");
            return;
        }

        isSaving = true;
        SetLoading(true);
        ClearMessages();
        
        try
        {
            if (isEditMode)
            {
                LogInfo($"Updating task with ID {taskFormModel.Id}");
                var updateTaskDto = Mapper.Map<UpdateTaskDto>(taskFormModel);
                var result = await TaskService.UpdateTask(updateTaskDto.Id, updateTaskDto);

                if (result.Success)
                {
                    SetSuccess("Opgaven er opdateret.");
                    await LoadTasks();
                    isTaskFormVisible = false;
                    ResetForm();
                }
                else
                {
                    SetError(result.Error ?? "Kunne ikke opdatere opgave.");
                }
            }
            else
            {
                LogInfo("Creating new task");
                var createTaskDto = Mapper.Map<CreateTaskDto>(taskFormModel);
                var result = await TaskService.CreateTask(createTaskDto);

                if (result.Success)
                {
                    SetSuccess("Opgaven er oprettet.");
                    await LoadTasks();
                    isTaskFormVisible = false;
                    ResetForm();
                }
                else
                {
                    SetError(result.Error ?? "Kunne ikke oprette opgave.");
                }
            }
        }
        catch (Exception ex)
        {
            LogError("Error in SaveTask", ex);
            SetError($"Fejl: {ex.Message}");
        }
        finally
        {
            isSaving = false;
            SetLoading(false);
        }
    }


    private void ResetForm()
    {
        taskFormModel = new TaskFormModel();
        isEditMode = false;
    }

    private void CancelTaskForm()
    {
        isTaskFormVisible = false;
        ResetForm();
    }

    private async Task DeleteTask(int taskId)
    {
        SetLoading(true);
        ClearMessages();
        
        try
        {
            var result = await TaskService.DeleteTask(taskId);
            if (result.Success)
            {
                SetSuccess("Opgaven er slettet.");
                await LoadTasks();
            }
            else
            {
                SetError(result.Error ?? "Kunne ikke slette opgave.");
            }
        }
        catch (Exception ex)
        {
            LogError("Error deleting task", ex);
            SetError($"Fejl ved sletning: {ex.Message}");
        }
        finally
        {
            SetLoading(false);
        }
    }

    private void AddStep(int taskId)
    {
        currentStep = new TaskStepFormModel { TaskId = taskId };
        isEditStepMode = false;
        isStepFormVisible = true;
    }

    private void EditStep(ReadTaskStepDto step)
    {
        currentStep = Mapper.Map<TaskStepFormModel>(step);
        isEditStepMode = true;
        isStepFormVisible = true;
    }

    private async Task SaveStep()
    {
        SetLoading(true);
        ClearMessages();
        
        try
        {
            if (isEditStepMode)
            {
                LogInfo($"Updating step ID {currentStep.Id} for task ID {currentStep.TaskId}");
                var updateStepDto = Mapper.Map<UpdateTaskStepDto>(currentStep);
                var result = await TaskStepService.UpdateTaskStep(updateStepDto.TaskId, updateStepDto.Id, updateStepDto);
                
                if (!result.Success)
                {
                    SetError(result.Error ?? "Kunne ikke opdatere trin.");
                    SetLoading(false);
                    return;
                }
            }
            else
            {
                LogInfo($"Creating new step for task ID {currentStep.TaskId}");
                var createStepDto = Mapper.Map<CreateTaskStepDto>(currentStep);
                var result = await TaskStepService.CreateTaskStep(createStepDto);
                
                if (!result.Success)
                {
                    SetError(result.Error ?? "Kunne ikke oprette trin.");
                    SetLoading(false);
                    return;
                }
            }

            await UpdateTaskSteps(currentStep.TaskId);
            isStepFormVisible = false;
            ResetStepForm();
            SetSuccess("Trin er gemt.");
        }
        catch (Exception ex)
        {
            LogError("Error in SaveStep", ex);
            SetError($"Fejl: {ex.Message}");
        }
        finally
        {
            SetLoading(false);
        }
    }

    private void ResetStepForm()
    {
        currentStep = new TaskStepFormModel();
        isEditStepMode = false;
    }

    private void CancelStepForm()
    {
        isStepFormVisible = false;
        ResetStepForm();
    }

    private async Task UpdateTaskSteps(int taskId)
    {
        var result = await TaskStepService.GetStepsForTask(taskId);
        if (result.Success && result.Data != null)
        {
            var index = Tasks.FindIndex(t => t.Id == taskId);
            if (index >= 0)
            {
                var task = Tasks[index];
                Tasks[index] = new ReadTaskDto
                {
                    Id = task.Id,
                    Name = task.Name,
                    Description = task.Description,
                    Image = task.Image,
                    UserId = task.UserId,
                    Steps = result.Data
                };
                StateHasChanged();
            }
        }
    }

    private async Task DeleteStep(int taskId, int stepId)
    {
        try
        {
            var result = await TaskStepService.DeleteTaskStep(taskId, stepId);
            if (result.Success)
            {
                await UpdateTaskSteps(taskId);
                SetSuccess("Trin er slettet.");
            }
            else
            {
                SetError(result.Error ?? "Kunne ikke slette trin.");
            }
        }
        catch (Exception ex)
        {
            LogError("Error deleting step", ex);
            SetError($"Fejl ved sletning: {ex.Message}");
        }
    }

    private Task OnDeleteStepHandler(int stepId)
    {
        var task = Tasks.FirstOrDefault(t => t.Steps.Any(s => s.Id == stepId));
        if (task != null)
        {
            int taskId = task.Id;
            return DeleteStep(taskId, stepId);
        }
        else
        {
            LogWarning($"Could not find task for step ID {stepId}");
            SetError("Kunne ikke finde opgaven for det givne trin");
            return Task.CompletedTask;
        }
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        if (e.FileCount > 0)
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024); // Max størrelse: 10 MB
            var buffer = new byte[file.Size];
            await stream.ReadAsync(buffer);
            currentStep.ImageBase64 = Convert.ToBase64String(buffer);

            LogInfo("Image converted to base64");
        }
        else
        {
            LogWarning("No file selected");
        }
    }
}