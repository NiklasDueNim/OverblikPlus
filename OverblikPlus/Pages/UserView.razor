@page "/user/{userId}"
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Models.Dtos.User
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.Components.Shared
@using OverblikPlus.Components
@inject IUserService UserService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inherits BasePage

<div class="userview-page">
    <button class="btn-back" @onclick="GoBack"><i class="fas fa-arrow-left me-1"></i> Tilbage</button>
    <h1 class="userview-title">Brugerprofil</h1>

    <AlertMessage Message="@ErrorMessage" Type="AlertType.Error" MessageChanged="@((string? msg) => ErrorMessage = msg)" />

    @if (IsLoading)
    {
        <LoadingSpinner Text="Indlæser brugerprofil..." />
    }
    else if (user == null)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Brugeren blev ikke fundet.
        </div>
    }
    else
    {
        <div class="profile-card">
            <div class="profile-avatar">@Initials</div>
            <h2 class="profile-name">@user.FirstName @user.LastName</h2>
            <span class="role-badge role-@(user.Role?.ToLower())">@user.Role</span>

            <div class="profile-field">
                <span class="profile-label">Brugernavn</span>
                <span class="profile-value">@user.Username</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? userId { get; set; }
    private ReadUserDto? user;

    private string Initials =>
        user == null
            ? "?"
            : $"{First(user.FirstName)}{First(user.LastName)}".ToUpper();

    private static string First(string? s) => string.IsNullOrEmpty(s) ? "" : s.Substring(0, 1);

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(userId))
        {
            userId = AuthStateProvider.GetUserId();
        }

        if (!string.IsNullOrEmpty(userId))
        {
            await LoadUser(userId);
        }
        else
        {
            SetError("Bruger ID mangler.");
        }
    }

    private async Task LoadUser(string id)
    {
        SetLoading(true);
        ClearMessages();

        try
        {
            var result = await UserService.GetUserById(id);
            if (result.Success && result.Data != null)
            {
                user = result.Data;
                LogInfo($"Loaded user {id}");
            }
            else
            {
                SetError(result.Error ?? "Brugeren blev ikke fundet.");
            }
        }
        catch (Exception ex)
        {
            LogError("Error loading user", ex);
            SetError("Kunne ikke hente brugerprofil. Prøv igen senere.");
        }
        finally
        {
            SetLoading(false);
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/user-list");
    }
}
