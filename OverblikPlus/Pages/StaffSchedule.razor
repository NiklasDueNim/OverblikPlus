@page "/schedule"
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Models
@using OverblikPlus.Models.Dtos.Shift
@using OverblikPlus.Models.Dtos.User
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.Components.Shared
@using OverblikPlus.Components
@using OverblikPlus.Constants
@inject CustomAuthStateProvider AuthStateProvider
@inject IUserService UserService
@inject IShiftService ShiftService
@inject IJSRuntime JSRuntime
@using Microsoft.JSInterop
@inherits BasePage

<div>
    <h3>Vagtplan (@today.ToShortDateString())</h3>

    <AlertMessage Message="@ErrorMessage" Type="AlertType.Error" MessageChanged="@((string? msg) => ErrorMessage = msg)" />
    <AlertMessage Message="@SuccessMessage" Type="AlertType.Success" MessageChanged="@((string? msg) => SuccessMessage = msg)" />

    @if (IsLoading)
    {
        <LoadingSpinner Text="Henter vagtplan..." />
    }
    else if (staffMembers == null || !staffMembers.Any())
    {
        <p>Ingen personale fundet.</p>
    }
    else
    {
        @if (IsAdmin())
        {
            <div class="mb-3">
                <button class="btn btn-primary" @onclick="ShowCreateForm">Opret vagt</button>
            </div>

            @if (showCreateForm)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <h5>Opret ny vagt</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="selectedStaff" class="form-label">Personale:</label>
                            <select id="selectedStaff" class="form-select" @bind="selectedStaffId">
                                <option value="">Vælg personale</option>
                                @foreach (var staff in staffMembers)
                                {
                                    <option value="@staff.Id">@staff.FirstName @staff.LastName (@staff.Role)</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="shiftDate" class="form-label">Dato:</label>
                            <input id="shiftDate" type="date" class="form-control" @bind="newShiftDate" />
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <label for="startTime" class="form-label">Starttid:</label>
                                <input id="startTime" type="time" class="form-control" @bind="newStartTime" />
                            </div>
                            <div class="col-md-6">
                                <label for="endTime" class="form-label">Sluttid:</label>
                                <input id="endTime" type="time" class="form-control" @bind="newEndTime" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <button class="btn btn-success" @onclick="CreateShift" disabled="@IsLoading">Gem vagt</button>
                            <button class="btn btn-secondary ms-2" @onclick="CancelCreateForm">Annuller</button>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- Tabel med alle personale -->
        <table class="table">
            <thead>
            <tr>
                <th>Navn</th>
                <th>Rolle</th>
                <th>Fra</th>
                <th>Til</th>
                @if (IsAdmin())
                {
                    <th>Handlinger</th>
                }
            </tr>
            </thead>
            <tbody>
            @foreach (var staff in staffMembers)
            {
                var staffShifts = shiftsByStaffId.GetValueOrDefault(staff.Id) ?? new List<ShiftDto>();
                @if (staffShifts.Any())
                {
                    @foreach (var shift in staffShifts)
                    {
                        <tr>
                            <td>@staff.FirstName @staff.LastName</td>
                            <td>@staff.Role</td>
                            <td>@shift.StartTime.ToShortTimeString()</td>
                            <td>@shift.EndTime.ToShortTimeString()</td>
                            @if (IsAdmin())
                            {
                                <td>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteShift(shift.Id)">Slet</button>
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td>@staff.FirstName @staff.LastName</td>
                        <td>@staff.Role</td>
                        <td colspan="@(IsAdmin() ? "3" : "2")" class="text-muted">Ingen vagt</td>
                    </tr>
                }
            }
            </tbody>
        </table>
    }
</div>

@code {
    private DateTime today = DateTime.Today;
    private List<ShiftDto> shifts = new();
    private List<ReadUserDto> staffMembers = new();
    private Dictionary<string, List<ShiftDto>> shiftsByStaffId = new();
    private bool showCreateForm = false;
    private string selectedStaffId = string.Empty;
    private DateTime newShiftDate = DateTime.Today;
    private TimeOnly? newStartTime = new TimeOnly(8, 0);
    private TimeOnly? newEndTime = new TimeOnly(16, 0);

    protected override async Task OnInitializedAsync()
    {
        SetLoading(true);
        await LoadStaffMembers();
        await LoadShifts();
        await IsAdminAsync(); // Cache admin status
        SetLoading(false);
    }

    private bool? _isAdmin;
    
    private async Task<bool> IsAdminAsync()
    {
        if (!_isAdmin.HasValue)
        {
            var role = await AuthStateProvider.GetRoleAsync();
            _isAdmin = role == "Admin";
        }
        return _isAdmin.Value;
    }
    
    private bool IsAdmin() => _isAdmin ?? false;

    private async Task LoadStaffMembers()
    {
        try
        {
            var bostedId = AuthStateProvider.GetBostedIdAsync();
            if (!bostedId.HasValue)
            {
                LogWarning("Could not retrieve bostedId");
                SetError("Kunne ikke hente bostedId");
                return;
            }

            var result = await UserService.GetUsersByBostedId(bostedId.Value);
            // Filtrer til kun Staff og Admin og sorter én gang
            var staffRoles = new[] { Roles.Staff, Roles.Admin, "Medarbejder" };
            if (result.Success && result.Data != null)
            {
                staffMembers = result.Data
                    .Where(u => staffRoles.Contains(u.Role))
                    .OrderBy(s => s.FirstName)
                    .ThenBy(s => s.LastName)
                    .ToList();
                LogInfo($"Loaded {staffMembers.Count} staff members");
            }
            else
            {
                LogWarning($"Failed to load staff members: {result.Error}");
                staffMembers = new List<ReadUserDto>();
            }
        }
        catch (Exception ex)
        {
            LogError("Error loading staff members", ex);
            SetError($"Fejl ved hentning af personale: {ex.Message}");
            staffMembers = new List<ReadUserDto>();
        }
    }

    private async Task LoadShifts()
    {
        try
        {
            var result = await ShiftService.GetShifts(today, today);
            if (result.Success && result.Data != null)
            {
                shifts = result.Data;
                // Cache shifts by staff ID for faster lookup
                shiftsByStaffId = shifts
                    .Where(s => s.StartTime.Date == today.Date)
                    .GroupBy(s => s.UserId)
                    .ToDictionary(g => g.Key, g => g.OrderBy(s => s.StartTime).ToList());
                LogInfo($"Loaded {shifts.Count} shifts");
            }
            else
            {
                LogWarning($"Failed to load shifts: {result.Error}");
                shifts = new List<ShiftDto>();
                shiftsByStaffId.Clear();
            }
        }
        catch (Exception ex)
        {
            LogError("Error loading shifts", ex);
            SetError($"Fejl ved hentning af vagter: {ex.Message}");
            shifts = new List<ShiftDto>();
            shiftsByStaffId.Clear();
        }
    }

    private void ShowCreateForm()
    {
        showCreateForm = true;
        ClearMessages();
        selectedStaffId = string.Empty;
        newShiftDate = today;
        newStartTime = new TimeOnly(8, 0);
        newEndTime = new TimeOnly(16, 0);
    }

    private void CancelCreateForm()
    {
        showCreateForm = false;
        ClearMessages();
    }

    private async Task CreateShift()
    {
        if (string.IsNullOrEmpty(selectedStaffId))
        {
            SetError("Vælg venligst personale");
            return;
        }

        SetLoading(true);
        ClearMessages();

        try
        {
            if (!newStartTime.HasValue || !newEndTime.HasValue)
            {
                SetError("Vælg venligst både starttid og sluttid");
                SetLoading(false);
                return;
            }

            var startDateTime = newShiftDate.Date.Add(newStartTime.Value.ToTimeSpan());
            var endDateTime = newShiftDate.Date.Add(newEndTime.Value.ToTimeSpan());

            if (endDateTime <= startDateTime)
            {
                SetError("Sluttid skal være efter starttid");
                SetLoading(false);
                return;
            }

            var newShift = new ShiftDto
            {
                Id = Guid.NewGuid(),
                UserId = selectedStaffId,
                StartTime = startDateTime,
                EndTime = endDateTime
            };

            var result = await ShiftService.CreateShiftAsync(newShift);

            if (result.Success)
            {
                SetSuccess("Vagt oprettet succesfuldt");
                LogInfo("Shift created successfully");
                await LoadShifts();
                CancelCreateForm();
            }
            else
            {
                SetError(result.Error ?? "Fejl ved oprettelse af vagt");
            }
        }
        catch (Exception ex)
        {
            LogError("Error creating shift", ex);
            SetError($"Fejl ved oprettelse af vagt: {ex.Message}");
        }
        finally
        {
            SetLoading(false);
        }
    }

    private async Task DeleteShift(Guid shiftId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Er du sikker på, at du vil slette denne vagt?");
        if (!confirmed)
        {
            return;
        }

        SetLoading(true);
        ClearMessages();
        
        try
        {
            var result = await ShiftService.DeleteShiftAsync(shiftId);
            if (result.Success)
            {
                SetSuccess("Vagt slettet succesfuldt");
                LogInfo("Shift deleted successfully");
                await LoadShifts();
            }
            else
            {
                SetError(result.Error ?? "Fejl ved sletning af vagt");
            }
        }
        catch (Exception ex)
        {
            LogError("Error deleting shift", ex);
            SetError($"Fejl ved sletning af vagt: {ex.Message}");
        }
        finally
        {
            SetLoading(false);
        }
    }
}