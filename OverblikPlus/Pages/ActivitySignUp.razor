@page "/activities"
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Models.Dtos.Activity
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.Services
@inject IActivityService ActivityService
@inject IUserService UserService
@inject CustomAuthStateProvider AuthStateProvider
@inject ActivityNoticeService NoticeService
@using OverblikPlus.Constants
@using OverblikPlus.Components
@using OverblikPlus.Components.Shared
@inherits BasePage

<div class="container-fluid activities-page">
    <div class="row">
        <div class="col-12">

            <AlertMessage Message="@ErrorMessage" Type="AlertType.Error" MessageChanged="@((string? msg) => ErrorMessage = msg)" />

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="mb-0">Aktiviteter for @DateTime.Today.ToString("dddd, dd. MMMM yyyy")</h2>
                @if (userRole == "Staff" || userRole == "Admin")
                {
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-primary" @onclick="OpenNoticeDialog">
                            <i class="fas fa-bullhorn me-1"></i>
                            Send hurtig besked
                        </button>
                        <a href="/create-activity" class="btn btn-success">
                            <i class="fas fa-plus me-1"></i>
                            Opret Aktivitet
                        </a>
                    </div>
                }
            </div>

            @if (showNoticeDialog)
            {
                <div class="notice-backdrop" @onclick="CloseNoticeDialog">
                    <div class="notice-dialog" @onclick:stopPropagation="true">
                        <h3 class="notice-dialog-title"><i class="fas fa-bullhorn me-2"></i>Send besked til beboerne</h3>
                        <p class="notice-dialog-help">Beskeden vises med det samme hos de beboere, der er logget ind.</p>

                        <div class="notice-templates">
                            @foreach (var tpl in NoticeTemplates)
                            {
                                <button type="button" class="notice-template" @onclick="@(() => noticeText = tpl)">@tpl</button>
                            }
                        </div>

                        <textarea class="notice-input" rows="3" placeholder="Skriv en besked..." @bind="noticeText" @bind:event="oninput"></textarea>

                        @if (!string.IsNullOrEmpty(noticeFeedback))
                        {
                            <div class="notice-feedback">@noticeFeedback</div>
                        }

                        <div class="notice-actions">
                            <button class="btn btn-secondary" @onclick="CloseNoticeDialog">Luk</button>
                            <button class="btn btn-primary" disabled="@(sendingNotice || string.IsNullOrWhiteSpace(noticeText))" @onclick="SendNotice">
                                <i class="fas fa-paper-plane me-1"></i>
                                @(sendingNotice ? "Sender..." : "Send")
                            </button>
                        </div>
                    </div>
                </div>
            }

@if (activities == null)
{
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Henter aktiviteter...</span>
                    </div>
                    <p class="mt-2">Henter aktiviteter...</p>
                </div>
            }
            else if (!activities.Any())
            {
                <div class="alert alert-info">
                    <h5>Ingen aktiviteter i dag</h5>
                    <p>Der er ingen planlagte aktiviteter for i dag.</p>
                </div>
}
else
{
                <div class="row">
                    @foreach (var act in activities.OrderBy(a => a.StartDateTime))
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 @GetActivityCardClass(act)">
                                <div class="card-header d-flex justify-content-between align-items-center">
                                    <h5 class="card-title mb-0">@act.Title</h5>
                                    <span class="badge @GetActivityTypeBadgeClass(act.ActivityType)">@GetActivityTypeName(act.ActivityType)</span>
                                </div>
                                <div class="card-body">
                                    <p class="card-text">@act.Description</p>
                                    
                                    <div class="mb-3">
                                        <div class="d-flex align-items-center mb-1">
                                            <i class="fas fa-clock me-2"></i>
                                            <strong>Tid:</strong>
                                        </div>
                                        <p class="mb-0">@act.StartDateTime.ToString("HH:mm") - @act.EndDateTime.ToString("HH:mm")</p>
                                        
                                        @if (!string.IsNullOrEmpty(act.Location))
                                        {
                                            <div class="d-flex align-items-center mb-1 mt-2">
                                                <i class="fas fa-map-marker-alt me-2"></i>
                                                <strong>Sted:</strong>
                                            </div>
                                            <p class="mb-0">@act.Location</p>
                                        }
                                    </div>

                                    <!-- Ansvarspersoner -->
                                    @if (act.ResponsibleStaff.Any())
                                    {
                                        <div class="mb-3">
                                            <div class="d-flex align-items-center mb-1">
                                                <i class="fas fa-user-tie me-2"></i>
                                                <strong>Ansvarlige:</strong>
                                            </div>
                                            <div>
                                                @foreach (var staffId in act.ResponsibleStaff)
                                                {
                                                    <span class="badge bg-info me-1">@GetStaffNameSync(staffId)</span>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <!-- Deltagere -->
                                    <div class="mb-3">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center">
                                                <i class="fas fa-users me-2"></i>
                                                <strong>Deltagere (@act.Participants.Count/@act.MaxParticipants):</strong>
                                            </div>
                                            @if (act.Participants.Count > 0)
                                            {
                                                <small class="text-muted">
                                                    @if (act.Participants.Count == act.MaxParticipants)
                                                    {
                                                        <i class="fas fa-exclamation-triangle text-warning me-1"></i>
                                                        <text>Fuldt booket</text>
                                                    }
                                                    else
                                                    {
                                                        <text>@(act.MaxParticipants - act.Participants.Count) pladser tilbage</text>
                                                    }
                                                </small>
                                            }
                                        </div>
                                        
                                        @if (act.Participants.Any())
                                        {
                                            <div class="participants-list">
                                                @foreach (var participantId in act.Participants)
                                                {
                                                    <div class="participant-item d-flex align-items-center mb-1 p-2 bg-light rounded">
                                                        <i class="fas fa-user-circle text-primary me-2"></i>
                                                        <span class="participant-name">@GetResidentNameSync(participantId)</span>
                                                        @if (participantId == currentUserId)
                                                        {
                                                            <span class="badge bg-success ms-auto">Du</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center p-3 bg-light rounded">
                                                <i class="fas fa-user-plus text-muted mb-2" style="font-size: 1.5rem;"></i>
                                                <p class="text-muted small mb-0">Ingen deltagere endnu</p>
                                                <small class="text-muted">Vær den første til at tilmelde dig!</small>
                                            </div>
                                        }
                                    </div>

                                    <!-- Særlige krav -->
                                    @if (!string.IsNullOrEmpty(act.SpecialRequirements))
                                    {
                                        <div class="alert alert-warning alert-sm">
                                            <i class="fas fa-exclamation-triangle me-1"></i>
                                            <strong>Bemærk:</strong> @act.SpecialRequirements
                                        </div>
                                    }

                                    <!-- Tilgængelighed -->
                                    @if (act.RequiresAssistance)
                                    {
                                        <div class="alert alert-info alert-sm">
                                            <i class="fas fa-wheelchair me-1"></i>
                                            Kræver hjælp
                                        </div>
                                    }
                                </div>
                                
                                <div class="card-footer">
                                    @if (CanParticipate(act))
                                    {
                                        <button class="btn btn-primary w-100" 
                                                disabled="@isJoining" 
                                                @onclick="() => Join(act.Id)">
                                            @(isJoining ? "Tilmelder..." : "Deltag i aktivitet")
                                        </button>
                                    }
                                    else if (act.Participants.Contains(currentUserId))
                                    {
                                        <button class="btn btn-secondary w-100" 
                                                disabled="@isLeaving" 
                                                @onclick="() => Leave(act.Id)">
                                            @(isLeaving ? "Forlader..." : "Forlad aktivitet")
                                        </button>
                }
                else
                {
                                        <button class="btn btn-outline-secondary w-100" disabled>
                                            @GetCannotParticipateReason(act)
                                        </button>
                }
                                </div>
            </div>
        </div>
    }
                </div>
}
        </div>
    </div>
</div>

@code {
    private List<ActivityDto> activities = new();
    private string currentUserId = string.Empty;
    private bool isJoining = false;
    private bool isLeaving = false;
    private string userRole = string.Empty;
    private Dictionary<string, string> userNames = new();

    private bool showNoticeDialog = false;
    private string noticeText = string.Empty;
    private bool sendingNotice = false;
    private string? noticeFeedback;
    private static readonly string[] NoticeTemplates =
    {
        "Kortspil i fællestuen om 5 min",
        "Kaffe i fællestuen nu",
        "Gåtur om 10 minutter",
        "Fælles aftensmad om 15 min"
    };

    private void OpenNoticeDialog()
    {
        noticeText = string.Empty;
        noticeFeedback = null;
        showNoticeDialog = true;
    }

    private void CloseNoticeDialog() => showNoticeDialog = false;

    private async Task SendNotice()
    {
        if (string.IsNullOrWhiteSpace(noticeText)) return;

        sendingNotice = true;
        noticeFeedback = null;
        try
        {
            var sender = AuthStateProvider.User != null
                ? $"{AuthStateProvider.User.FirstName} {AuthStateProvider.User.LastName}".Trim()
                : "Personale";

            var ok = await NoticeService.SendAsync(sender, noticeText.Trim());
            if (ok)
            {
                noticeFeedback = "Beskeden er sendt ✓";
                noticeText = string.Empty;
            }
            else
            {
                noticeFeedback = "Kunne ikke sende lige nu (ingen forbindelse). Prøv igen.";
            }
        }
        catch (Exception ex)
        {
            noticeFeedback = "Der opstod en fejl ved afsendelse.";
            LogError("Error sending activity notice", ex);
        }
        finally
        {
            sendingNotice = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        currentUserId = AuthStateProvider.User?.Id ?? string.Empty;
        userRole = AuthStateProvider.GetRole();
        await LoadUserNames();
        await LoadActivities();
    }

    private async Task LoadUserNames()
    {
        try
        {
            var result = await UserService.GetAllUsers();
            if (result.Success && result.Data != null)
            {
                userNames = result.Data.ToDictionary(
                    u => u.Id,
                    u => $"{u.FirstName} {u.LastName}".Trim());
            }
        }
        catch (Exception ex)
        {
            LogError("Error loading user names", ex);
        }
    }

    private async Task LoadActivities()
    {
        try
        {
            activities = await ActivityService.GetAllActivitiesAsync();
        }
        catch (Exception ex)
        {
            LogError("Error loading activities", ex);
            SetError("Kunne ikke hente aktiviteter. Prøv igen senere.");
            activities = new List<ActivityDto>();
        }
    }

    private async Task Join(Guid activityId)
    {
        if (isJoining) return;
        
        isJoining = true;
        try
        {
            var result = await ActivityService.JoinActivityAsync(activityId, currentUserId);
            if (result.Success)
            {
        var act = activities.First(a => a.Id == activityId);
        act.Participants.Add(currentUserId);
                StateHasChanged();
            }
            else
            {
                SetError(result.ErrorMessage ?? "Kunne ikke tilmelde dig aktiviteten.");
            }
        }
        catch (Exception ex)
        {
            LogError("Exception joining activity", ex);
            SetError("Der opstod en fejl ved tilmelding.");
        }
        finally
        {
            isJoining = false;
        }
    }

    private async Task Leave(Guid activityId)
    {
        if (isLeaving) return;
        
        isLeaving = true;
        try
        {
            var result = await ActivityService.LeaveActivityAsync(activityId, currentUserId);
            if (result.Success)
            {
        var act = activities.First(a => a.Id == activityId);
        act.Participants.Remove(currentUserId);
                StateHasChanged();
            }
            else
            {
                SetError(result.ErrorMessage ?? "Kunne ikke forlade aktiviteten.");
            }
        }
        catch (Exception ex)
        {
            LogError("Exception leaving activity", ex);
            SetError("Der opstod en fejl.");
        }
        finally
        {
            isLeaving = false;
        }
    }

    private bool CanParticipate(ActivityDto activity)
    {
        // Kun beboere kan tilmelde sig
        if (userRole != Roles.User) return false;
        
        // Tjek om beboeren allerede er tilmeldt
        if (activity.Participants.Contains(currentUserId)) return false;
        
        // Tjek om aktivitet er i fremtiden
        if (activity.StartDateTime <= DateTime.Now) return false;
        
        // Tjek om der er plads
        if (activity.Participants.Count >= activity.MaxParticipants) return false;
        
        return true;
    }

    private string GetCannotParticipateReason(ActivityDto activity)
    {
        if (userRole != Roles.User) return "Kun for beboere";
        if (activity.Participants.Contains(currentUserId)) return "Allerede tilmeldt";
        if (activity.StartDateTime <= DateTime.Now) return "Aktivitet er startet";
        if (activity.Participants.Count >= activity.MaxParticipants) return "Aktivitet er fuld";
        return "Kan ikke deltage";
    }

    private string GetActivityCardClass(ActivityDto activity)
    {
        if (activity.StartDateTime <= DateTime.Now) return "border-secondary";
        if (activity.Participants.Count >= activity.MaxParticipants) return "border-warning";
        return "border-primary";
    }

    private string GetActivityTypeBadgeClass(ActivityType activityType)
    {
        return activityType switch
        {
            ActivityType.FysiskAktivitet => "bg-success",
            ActivityType.SocialAktivitet => "bg-primary",
            ActivityType.KreativAktivitet => "bg-warning",
            ActivityType.KognitivAktivitet => "bg-info",
            ActivityType.MusikAktivitet => "bg-danger",
            ActivityType.MadAktivitet => "bg-secondary",
            ActivityType.Udflugt => "bg-dark",
            _ => "bg-light text-dark"
        };
    }

    private string GetActivityTypeName(ActivityType activityType)
    {
        return activityType switch
        {
            ActivityType.FysiskAktivitet => "Fysisk",
            ActivityType.SocialAktivitet => "Social",
            ActivityType.KreativAktivitet => "Kreativ",
            ActivityType.KognitivAktivitet => "Kognitiv",
            ActivityType.MusikAktivitet => "Musik",
            ActivityType.MadAktivitet => "Mad",
            ActivityType.Udflugt => "Udflugt",
            _ => "Andet"
        };
    }

    private string GetStaffNameSync(string userId)
    {
        return userNames.TryGetValue(userId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : "Medarbejder";
    }

    private string GetResidentNameSync(string userId)
    {
        return userNames.TryGetValue(userId, out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : "Beboer";
    }

    private async Task<string> GetStaffName(Guid userId)
    {
        try
        {
            var result = await UserService.GetUserById(userId.ToString());
            if (result.Success && result.Data != null)
            {
                return $"{result.Data.FirstName} {result.Data.LastName}";
            }
            return "Ukendt medarbejder";
        }
        catch
        {
            return "Ukendt medarbejder";
        }
    }

    private async Task<string> GetResidentName(Guid userId)
    {
        try
        {
            var result = await UserService.GetUserById(userId.ToString());
            if (result.Success && result.Data != null)
            {
                return $"{result.Data.FirstName} {result.Data.LastName}";
            }
            return "Ukendt beboer";
        }
        catch
        {
            return "Ukendt beboer";
        }
    }
}
