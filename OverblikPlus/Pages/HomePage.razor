@page "/"
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Models.Dashboard
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.Components.Dashboard
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using System.Timers
    <AuthorizeView>
        <Authorized>
        <!-- Widget-based Dashboard for logged in users -->
        <div class="dashboard-container">
            @if (showWelcomeMessage)
            {
                <div class="welcome-section">
                    <h1 class="welcome-title">Velkommen tilbage, @AuthStateProvider.User?.FirstName!</h1>
                    <p class="welcome-subtitle">Her er dit personlige dashboard</p>
                </div>
            }
            
            <div class="dashboard-controls">
                <div class="dashboard-actions">
                    <button class="btn btn-outline-primary btn-sm" @onclick="ToggleEditMode">
                        <i class="fas fa-cog me-1"></i>
                        @(isEditMode ? "Færdig" : "Tilpas")
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ResetLayout">
                        <i class="fas fa-undo me-1"></i>
                        Nulstil
                    </button>
                </div>
            </div>

            <div class="widgets-grid @(isEditMode ? "edit-mode" : "")">
                @foreach (var widget in GetVisibleWidgets())
                {
                    <div class="widget-container @GetWidgetSizeClass(widget.Size) @(draggedWidget == widget ? "dragging" : "")" 
                         draggable="@isEditMode"
                         @ondragstart="@(() => OnDragStart(widget))"
                         @ondragover:preventDefault
                         @ondrop="@(() => OnDrop(widget))"
                         @ondragenter="@(() => OnDragEnter(widget))"
                         @ondragleave="OnDragLeave"
                         @onclick="@(() => OnWidgetClick(widget))"
                         @onclick:stopPropagation="true">
                        @if (isEditMode)
                        {
                            <div class="drag-handle">
                                <i class="fas fa-grip-vertical"></i>
                        </div>
                        }
                        @if (widget.Type == "Tasks")
                        {
                            <TasksWidget @ref="tasksWidgetRef" WidgetInfo="widget" OnWidgetClicked="OnWidgetClick" />
                        }
                        else if (widget.Type == "Shifts")
                        {
                            <ShiftsWidget WidgetInfo="widget" OnWidgetClicked="OnWidgetClick" />
                        }
                        else if (widget.Type == "Activities")
                        {
                            <ActivitiesWidget WidgetInfo="widget" OnWidgetClicked="OnWidgetClick" />
                        }
                        else if (widget.Type == "QuickActions")
                        {
                            <QuickActionsWidget WidgetInfo="widget" OnWidgetClicked="OnWidgetClick" />
                        }
                        else if (widget.Type == "Notifications")
                        {
                            <NotificationsWidget WidgetInfo="widget" OnWidgetClicked="OnWidgetClick" />
                        }
                        else if (widget.Type == "Announcements")
                        {
                            <div class="widget-announcements">
                                <div class="widget-header">
                                    <h4>@widget.Title</h4>
                                </div>
                                <div class="widget-body">
                                    <p>Klik for at se alle opslag</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Landing page for non-authenticated users -->
        <div class="landing-page">
            <div class="hero-section">
                <div class="hero-content">
                    <div class="logo-section">
                        <div class="logo-icon">
                            <img src="/images/logo-blue.png" alt="OverblikPlus Logo" />
                        </div>
                        <h1 class="hero-title">OverblikPlus</h1>
                    </div>
                    <p class="hero-subtitle">Dit personlige overblik for et organiseret bosted</p>
                    <p class="hero-description">
                        Effektiv administration, kommunikation og opgavestyring samlet ét sted. 
                        Skab overblik og struktur for både beboere og personale.
                    </p>
                    <div class="hero-actions">
                        <a href="/login" class="btn-primary-large">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Log ind
                        </a>
                        <a href="/create-user" class="btn-secondary-large">
                            <i class="fas fa-user-plus me-2"></i>
                            Opret konto
                        </a>
                    </div>
                </div>
                <div class="hero-visual">
                    <div class="feature-cards">
                        <div class="feature-card">
                            <i class="fas fa-tasks"></i>
                            <h4>Opgavestyring</h4>
                            <p>Organiser daglige opgaver og rutiner</p>
                        </div>
                        <div class="feature-card">
                            <i class="fas fa-users"></i>
                            <h4>Aktiviteter</h4>
                            <p>Planlæg og deltag i fælles aktiviteter</p>
                            </div>
                        <div class="feature-card">
                            <i class="fas fa-comments"></i>
                            <h4>Kommunikation</h4>
                            <p>Effektiv kommunikation mellem alle</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="features-section">
                <div class="container">
                    <h2 class="features-title">Hvorfor vælge OverblikPlus?</h2>
                    <div class="features-grid">
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <h3>Dagligt overblik</h3>
                            <p>Få et klart overblik over dagens opgaver og aktiviteter</p>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fas fa-mobile-alt"></i>
                            </div>
                            <h3>Altid tilgængelig</h3>
                            <p>Adgang til dit overblik på alle enheder, når som helst</p>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <h3>Sikker og privat</h3>
                            <p>Dine data er beskyttet med moderne sikkerhedsteknologi</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </NotAuthorized>
    </AuthorizeView>

@code {
    private List<WidgetInfo> widgets = new();
    private bool isEditMode = false;
    private bool showWelcomeMessage = true;
    private System.Timers.Timer? welcomeTimer;
    private string userRole = string.Empty;
    private WidgetInfo? draggedWidget;
    private WidgetInfo? dragTargetWidget;
    
    // Reference to TasksWidget for refreshing
    private TasksWidget? tasksWidgetRef;

    [Inject] public CustomAuthStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] public NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        userRole = await AuthStateProvider.GetRoleAsync();
        
        // Redirect Relative brugere til announcements siden, da de ikke skal se dashboard
        if (userRole == "Relative")
        {
            NavigationManager.NavigateTo("/announcements");
            return;
        }
        
        await LoadDashboardSettings();
        
        // Set up welcome message timer
        welcomeTimer = new System.Timers.Timer(5000); // 5 seconds
        welcomeTimer.Elapsed += (sender, e) => {
            showWelcomeMessage = false;
            InvokeAsync(StateHasChanged);
        };
        welcomeTimer.Start();
        
        // Listen for navigation events to refresh dashboard
        NavigationManager.LocationChanged += OnLocationChanged;
    }
    
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Refresh dashboard when returning to home page or from task management
        if (e.Location.EndsWith("/") || 
            e.Location.Contains("localhost:5226/#") ||
            e.Location.Contains("/TaskManager") ||
            e.Location.Contains("/Calendar"))
        {
            InvokeAsync(async () =>
            {
                await LoadDashboardSettings();
                
                // Refresh tasks widget to show new tasks
                if (tasksWidgetRef != null)
                {
                    await tasksWidgetRef.RefreshTasks();
                }
                
                StateHasChanged();
            });
        }
    }

    private async Task LoadDashboardSettings()
    {
        // Initialize default widgets based on user role
        widgets = GetDefaultWidgets(userRole);
        
        // TODO: Load user's saved dashboard settings from backend
        // This would integrate with a DashboardSettingsService
    }

    private List<WidgetInfo> GetDefaultWidgets(string role)
    {
        var defaultWidgets = new List<WidgetInfo>();

        // Relative brugere skal kun se Announcements widget
        if (role == "Relative")
        {
            defaultWidgets.Add(new WidgetInfo
            {
                Id = "announcements",
                Title = "Opslagstavle",
                Type = "Announcements",
                Position = 1,
                Size = 3,
                IsVisible = true,
                Role = "Relative"
            });
            return defaultWidgets.OrderBy(w => w.Position).ToList();
        }

        // Common widgets for all users (ikke Relative)
        defaultWidgets.Add(new WidgetInfo
        {
            Id = "tasks",
            Title = "Mine Opgaver",
            Type = "Tasks",
            Position = 1,
            Size = 2,
            IsVisible = true,
            Role = "All"
        });

        defaultWidgets.Add(new WidgetInfo
        {
            Id = "quickactions",
            Title = "Hurtige Handlinger",
            Type = "QuickActions",
            Position = 2,
            Size = 1,
            IsVisible = true,
            Role = "All"
        });

        defaultWidgets.Add(new WidgetInfo
        {
            Id = "activities",
            Title = "Aktiviteter",
            Type = "Activities",
            Position = 3,
            Size = 2,
            IsVisible = true,
            Role = "All"
        });

        // Role-specific widgets
        if (role == "Admin" || role == "Staff")
        {
            defaultWidgets.Add(new WidgetInfo
            {
                Id = "shifts",
                Title = "Vagtplan",
                Type = "Shifts",
                Position = 4,
                Size = 2,
                IsVisible = true,
                Role = "Staff"
            });

            // Notifications widget disabled until backend is ready
            // defaultWidgets.Add(new WidgetInfo
            // {
            //     Id = "notifications",
            //     Title = "Notifikationer",
            //     Type = "Notifications",
            //     Position = 5,
            //     Size = 1,
            //     IsVisible = true,
            //     Role = "Staff"
            // });
        }

        return defaultWidgets.OrderBy(w => w.Position).ToList();
    }

    private List<WidgetInfo> GetVisibleWidgets()
    {
        return widgets.Where(w => w.IsVisible).ToList();
    }

    private string GetWidgetSizeClass(int size)
    {
        return size switch
        {
            1 => "widget-small",
            2 => "widget-medium",
            3 => "widget-large",
            _ => "widget-small"
        };
    }

    private async Task OnWidgetClick(WidgetInfo widget)
    {
        if (isEditMode)
        {
            // Handle widget editing (resize, move, etc.)
            await HandleWidgetEdit(widget);
        }
        else
        {
            // Handle widget click (navigate to full page)
            await HandleWidgetNavigation(widget);
        }
    }

    private async Task HandleWidgetEdit(WidgetInfo widget)
    {
        // TODO: Implement widget editing logic
        // This could include resizing, moving, or configuring widgets
        Console.WriteLine($"Editing widget: {widget.Title}");
    }

    private async Task HandleWidgetNavigation(WidgetInfo widget)
    {
        var url = widget.Type switch
        {
            "Tasks" => "/tasks",
            "Shifts" => "/schedule",
            "Activities" => "/activities",
            "Notifications" => "/notifications",
            "Announcements" => "/announcements",
            _ => "/"
        };
        
        NavigationManager.NavigateTo(url);
    }

    private void ToggleEditMode()
    {
        isEditMode = !isEditMode;
    }

    private async Task ResetLayout()
    {
        widgets = GetDefaultWidgets(userRole);
        StateHasChanged();
        
        // TODO: Save reset layout to backend
    }

    // Drag and Drop Methods
    private void OnDragStart(WidgetInfo widget)
    {
        draggedWidget = widget;
        Console.WriteLine($"Drag started: {widget.Title}");
    }

    private void OnDragEnter(WidgetInfo widget)
    {
        if (draggedWidget != null && draggedWidget != widget)
        {
            dragTargetWidget = widget;
        }
    }

    private void OnDragLeave()
    {
        dragTargetWidget = null;
    }

    private void OnDrop(WidgetInfo targetWidget)
    {
        if (draggedWidget != null && draggedWidget != targetWidget)
        {
            // Swap positions
            var draggedIndex = widgets.IndexOf(draggedWidget);
            var targetIndex = widgets.IndexOf(targetWidget);

            if (draggedIndex != -1 && targetIndex != -1)
            {
                var draggedPosition = draggedWidget.Position;
                draggedWidget.Position = targetWidget.Position;
                targetWidget.Position = draggedPosition;

                // Re-order widgets
                widgets = widgets.OrderBy(w => w.Position).ToList();
                
                Console.WriteLine($"Swapped: {draggedWidget.Title} with {targetWidget.Title}");
                StateHasChanged();
            }
        }

        // Reset drag state
        draggedWidget = null;
        dragTargetWidget = null;
    }

    public void Dispose()
    {
        welcomeTimer?.Dispose();
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}