@page "/"
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Models.Dashboard
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.Components.Dashboard
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using System.Timers

<AuthorizeView>
    <Authorized>
        <!-- Widget-based Dashboard for logged in users -->
        <div class="dashboard-container">
            @if (showWelcomeMessage)
            {
                <div class="welcome-section">
                    <h1 class="welcome-title">Velkommen tilbage, @AuthStateProvider.User?.FirstName!</h1>
                    <p class="welcome-subtitle">Her er dit personlige dashboard</p>
                </div>
            }
            
            <DashboardControls IsEditMode="isEditMode"
                              OnToggleEditMode="ToggleEditMode"
                              OnResetLayout="ResetLayout" />

            @if (isEditMode)
            {
                <div class="widget-picker">
                    <p class="widget-picker-title">Vælg hvilke widgets der vises og hvor store de er. Træk dem rundt i griddet for at ændre rækkefølgen.</p>
                    <div class="widget-picker-list">
                        @foreach (var widget in widgets)
                        {
                            <div class="widget-picker-row @(widget.IsVisible ? "" : "is-hidden")">
                                <button type="button"
                                        class="widget-toggle @(widget.IsVisible ? "on" : "off")"
                                        @onclick="@(() => ToggleWidgetVisibility(widget))">
                                    <i class="fas @(widget.IsVisible ? "fa-eye" : "fa-eye-slash")"></i>
                                    @widget.Title
                                </button>
                                <div class="widget-size-select" title="Størrelse">
                                    <button type="button" class="@(widget.Size == 1 ? "active" : "")"
                                            @onclick="@(() => SetWidgetSize(widget, 1))">S</button>
                                    <button type="button" class="@(widget.Size == 2 ? "active" : "")"
                                            @onclick="@(() => SetWidgetSize(widget, 2))">M</button>
                                    <button type="button" class="@(widget.Size == 3 ? "active" : "")"
                                            @onclick="@(() => SetWidgetSize(widget, 3))">L</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="widgets-grid @(isEditMode ? "edit-mode" : "")">
                @foreach (var widget in GetVisibleWidgets())
                {
                    <WidgetContainer SizeClass="@GetWidgetSizeClass(widget.Size)"
                                     IsEditMode="isEditMode"
                                     IsDragging="@(draggedWidget == widget)"
                                     IsDropTarget="@(dragTargetWidget == widget)"
                                     OnDragStart="@(() => OnDragStart(widget))"
                                     OnDrop="@(() => OnDrop(widget))"
                                     OnDragEnter="@(() => OnDragEnter(widget))"
                                     OnDragLeave="OnDragLeave"
                                     OnClick="@(() => OnWidgetClick(widget))">
                        @if (widget.Type == "Tasks")
                        {
                            <WidgetRenderer Widget="widget" OnWidgetClicked="OnWidgetClick" @ref="tasksWidgetRendererRef" />
                        }
                        else
                        {
                            <WidgetRenderer Widget="widget" OnWidgetClicked="OnWidgetClick" />
                        }
                    </WidgetContainer>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <LandingPage />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<WidgetInfo> widgets = new();
    private bool isEditMode = false;
    private bool showWelcomeMessage = true;
    private System.Timers.Timer? welcomeTimer;
    private string userRole = string.Empty;
    private WidgetInfo? draggedWidget;
    private WidgetInfo? dragTargetWidget;
    
    // Reference to TasksWidget renderer for refreshing
    private WidgetRenderer? tasksWidgetRendererRef;

    [Inject] public CustomAuthStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] public NavigationManager NavigationManager { get; set; } = default!;
    [Inject] public IDashboardService DashboardService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        userRole = AuthStateProvider.GetRole();
        
        // Redirect Relative brugere til announcements siden, da de ikke skal se dashboard
        if (userRole == "Relative")
        {
            NavigationManager.NavigateTo("/announcements");
            return;
        }
        
        await LoadDashboardSettings();
        
        // Set up welcome message timer
        welcomeTimer = new System.Timers.Timer(5000); // 5 seconds
        welcomeTimer.Elapsed += (sender, e) => {
            showWelcomeMessage = false;
            InvokeAsync(StateHasChanged);
        };
        welcomeTimer.Start();
        
        // Listen for navigation events to refresh dashboard
        NavigationManager.LocationChanged += OnLocationChanged;
    }
    
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Refresh dashboard when returning to home page or from task management
        if (e.Location.EndsWith("/") || 
            e.Location.Contains("localhost:5226/#") ||
            e.Location.Contains("/TaskManager") ||
            e.Location.Contains("/Calendar"))
        {
            InvokeAsync(async () =>
            {
                await LoadDashboardSettings();
                
                // Refresh tasks widget to show new tasks
                if (tasksWidgetRendererRef != null)
                {
                    var tasksWidget = tasksWidgetRendererRef.GetTasksWidgetRef();
                    if (tasksWidget != null)
                    {
                        await tasksWidget.RefreshTasks();
                    }
                }
                
                StateHasChanged();
            });
        }
    }

    private async Task LoadDashboardSettings()
    {
        var defaults = GetDefaultWidgets(userRole);
        var saved = await DashboardService.LoadLayoutAsync(AuthStateProvider.GetUserId() ?? string.Empty);

        widgets = (saved != null && saved.Count > 0)
            ? MergeWidgets(defaults, saved)
            : defaults;
    }

    // Applies the user's saved order/visibility/size onto the current role catalog.
    // Widgets that are new since the layout was saved keep their default settings and
    // are appended, so added features still surface for existing users.
    private List<WidgetInfo> MergeWidgets(List<WidgetInfo> defaults, List<WidgetInfo> saved)
    {
        var maxSavedPosition = saved.Count > 0 ? saved.Max(w => w.Position) : 0;

        foreach (var widget in defaults)
        {
            var match = saved.FirstOrDefault(w => w.Id == widget.Id);
            if (match != null)
            {
                widget.Position = match.Position;
                widget.IsVisible = match.IsVisible;
                widget.Size = match.Size;
            }
            else
            {
                widget.Position = ++maxSavedPosition;
            }
        }

        return defaults.OrderBy(w => w.Position).ToList();
    }

    private async Task SaveLayout()
    {
        await DashboardService.SaveLayoutAsync(AuthStateProvider.GetUserId() ?? string.Empty, widgets);
    }

    private async Task ToggleWidgetVisibility(WidgetInfo widget)
    {
        widget.IsVisible = !widget.IsVisible;
        await SaveLayout();
        StateHasChanged();
    }

    private async Task SetWidgetSize(WidgetInfo widget, int size)
    {
        if (widget.Size == size)
            return;

        widget.Size = size;
        await SaveLayout();
        StateHasChanged();
    }

    private List<WidgetInfo> GetDefaultWidgets(string role)
    {
        var defaultWidgets = new List<WidgetInfo>();

        // Relative brugere skal kun se Announcements widget
        if (role == "Relative")
        {
            defaultWidgets.Add(new WidgetInfo
            {
                Id = "announcements",
                Title = "Opslagstavle",
                Type = "Announcements",
                Position = 1,
                Size = 3,
                IsVisible = true,
                Role = "Relative"
            });
            return defaultWidgets.OrderBy(w => w.Position).ToList();
        }

        // Common widgets for all users (ikke Relative)
        defaultWidgets.Add(new WidgetInfo
        {
            Id = "tasks",
            Title = "Mine Opgaver",
            Type = "Tasks",
            Position = 1,
            Size = 2,
            IsVisible = true,
            Role = "All"
        });

        defaultWidgets.Add(new WidgetInfo
        {
            Id = "quickactions",
            Title = "Hurtige Handlinger",
            Type = "QuickActions",
            Position = 2,
            Size = 1,
            IsVisible = true,
            Role = "All"
        });

        defaultWidgets.Add(new WidgetInfo
        {
            Id = "activities",
            Title = "Aktiviteter",
            Type = "Activities",
            Position = 3,
            Size = 2,
            IsVisible = true,
            Role = "All"
        });

        defaultWidgets.Add(new WidgetInfo
        {
            Id = "calendar",
            Title = "Kalender",
            Type = "Calendar",
            Position = 4,
            Size = 1,
            IsVisible = true,
            Role = "All"
        });

        defaultWidgets.Add(new WidgetInfo
        {
            Id = "mood",
            Title = "Mit humør",
            Type = "Mood",
            Position = 5,
            Size = 1,
            IsVisible = true,
            Role = "All"
        });

        defaultWidgets.Add(new WidgetInfo
        {
            Id = "budget",
            Title = "Budget",
            Type = "Budget",
            Position = 6,
            Size = 1,
            IsVisible = false,
            Role = "All"
        });

        defaultWidgets.Add(new WidgetInfo
        {
            Id = "messages",
            Title = "Beskeder",
            Type = "Messages",
            Position = 7,
            Size = 1,
            IsVisible = false,
            Role = "All"
        });

        // Role-specific widgets
        if (role == "Admin" || role == "Staff")
        {
            defaultWidgets.Add(new WidgetInfo
            {
                Id = "shifts",
                Title = "Vagtplan",
                Type = "Shifts",
                Position = 8,
                Size = 2,
                IsVisible = true,
                Role = "Staff"
            });

            // Notifications widget disabled until backend is ready
            // defaultWidgets.Add(new WidgetInfo
            // {
            //     Id = "notifications",
            //     Title = "Notifikationer",
            //     Type = "Notifications",
            //     Position = 5,
            //     Size = 1,
            //     IsVisible = true,
            //     Role = "Staff"
            // });
        }

        return defaultWidgets.OrderBy(w => w.Position).ToList();
    }

    private List<WidgetInfo> GetVisibleWidgets()
    {
        return widgets.Where(w => w.IsVisible).ToList();
    }

    private string GetWidgetSizeClass(int size)
    {
        return size switch
        {
            1 => "widget-small",
            2 => "widget-medium",
            3 => "widget-large",
            _ => "widget-small"
        };
    }

    private async Task OnWidgetClick(WidgetInfo widget)
    {
        if (isEditMode)
        {
            // Handle widget editing (resize, move, etc.)
            await HandleWidgetEdit(widget);
        }
        else
        {
            // Handle widget click (navigate to full page)
            await HandleWidgetNavigation(widget);
        }
    }

    private async Task HandleWidgetEdit(WidgetInfo widget)
    {
        // TODO: Implement widget editing logic
        // This could include resizing, moving, or configuring widgets
        // Widget editing functionality to be implemented
    }

    private async Task HandleWidgetNavigation(WidgetInfo widget)
    {
        var url = widget.Type switch
        {
            "Tasks" => "/tasks",
            "Shifts" => "/schedule",
            "Activities" => "/activities",
            "Calendar" => "/calendar",
            "Mood" => "/mood",
            "Budget" => "/budget",
            "Messages" => "/chatTest",
            "Notifications" => "/notifications",
            "Announcements" => "/announcements",
            _ => "/"
        };
        
        NavigationManager.NavigateTo(url);
    }

    private void ToggleEditMode()
    {
        isEditMode = !isEditMode;
    }

    private async Task ResetLayout()
    {
        await DashboardService.ClearLayoutAsync(AuthStateProvider.GetUserId() ?? string.Empty);
        widgets = GetDefaultWidgets(userRole);
        StateHasChanged();
    }

    // Drag and Drop Methods
    private void OnDragStart(WidgetInfo widget)
    {
        draggedWidget = widget;
    }

    private void OnDragEnter(WidgetInfo widget)
    {
        if (draggedWidget != null && draggedWidget != widget)
        {
            dragTargetWidget = widget;
            StateHasChanged();
        }
    }

    private void OnDragLeave()
    {
        dragTargetWidget = null;
        StateHasChanged();
    }

    private async Task OnDrop(WidgetInfo targetWidget)
    {
        var reordered = false;

        if (draggedWidget != null && draggedWidget != targetWidget)
        {
            // Swap positions
            var draggedIndex = widgets.IndexOf(draggedWidget);
            var targetIndex = widgets.IndexOf(targetWidget);

            if (draggedIndex != -1 && targetIndex != -1)
            {
                var draggedPosition = draggedWidget.Position;
                draggedWidget.Position = targetWidget.Position;
                targetWidget.Position = draggedPosition;

                // Re-order widgets
                widgets = widgets.OrderBy(w => w.Position).ToList();
                reordered = true;
            }
        }

        // Reset drag state
        draggedWidget = null;
        dragTargetWidget = null;

        if (reordered)
        {
            await SaveLayout();
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        welcomeTimer?.Dispose();
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}