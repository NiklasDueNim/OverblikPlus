@page "/"
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Models.Dashboard
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.Components.Dashboard
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using System.Timers

<AuthorizeView>
    <Authorized>
        <!-- Widget-based Dashboard for logged in users -->
        <div class="dashboard-container">
            @if (showWelcomeMessage)
            {
                <div class="welcome-section">
                    <h1 class="welcome-title">Velkommen tilbage, @AuthStateProvider.User?.FirstName!</h1>
                    <p class="welcome-subtitle">Her er dit personlige dashboard</p>
                </div>
            }
            
            <DashboardControls IsEditMode="isEditMode" 
                              OnToggleEditMode="ToggleEditMode" 
                              OnResetLayout="ResetLayout" />

            <div class="widgets-grid @(isEditMode ? "edit-mode" : "")">
                @foreach (var widget in GetVisibleWidgets())
                {
                    <WidgetContainer SizeClass="@GetWidgetSizeClass(widget.Size)"
                                     IsEditMode="isEditMode"
                                     IsDragging="@(draggedWidget == widget)"
                                     OnDragStart="@(() => OnDragStart(widget))"
                                     OnDrop="@(() => OnDrop(widget))"
                                     OnDragEnter="@(() => OnDragEnter(widget))"
                                     OnDragLeave="OnDragLeave"
                                     OnClick="@(() => OnWidgetClick(widget))">
                        @if (widget.Type == "Tasks")
                        {
                            <WidgetRenderer Widget="widget" OnWidgetClicked="OnWidgetClick" @ref="tasksWidgetRendererRef" />
                        }
                        else
                        {
                            <WidgetRenderer Widget="widget" OnWidgetClicked="OnWidgetClick" />
                        }
                    </WidgetContainer>
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <LandingPage />
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<WidgetInfo> widgets = new();
    private bool isEditMode = false;
    private bool showWelcomeMessage = true;
    private System.Timers.Timer? welcomeTimer;
    private string userRole = string.Empty;
    private WidgetInfo? draggedWidget;
    private WidgetInfo? dragTargetWidget;
    
    // Reference to TasksWidget renderer for refreshing
    private WidgetRenderer? tasksWidgetRendererRef;

    [Inject] public CustomAuthStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] public NavigationManager NavigationManager { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        userRole = await AuthStateProvider.GetRoleAsync();
        
        // Redirect Relative brugere til announcements siden, da de ikke skal se dashboard
        if (userRole == "Relative")
        {
            NavigationManager.NavigateTo("/announcements");
            return;
        }
        
        await LoadDashboardSettings();
        
        // Set up welcome message timer
        welcomeTimer = new System.Timers.Timer(5000); // 5 seconds
        welcomeTimer.Elapsed += (sender, e) => {
            showWelcomeMessage = false;
            InvokeAsync(StateHasChanged);
        };
        welcomeTimer.Start();
        
        // Listen for navigation events to refresh dashboard
        NavigationManager.LocationChanged += OnLocationChanged;
    }
    
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Refresh dashboard when returning to home page or from task management
        if (e.Location.EndsWith("/") || 
            e.Location.Contains("localhost:5226/#") ||
            e.Location.Contains("/TaskManager") ||
            e.Location.Contains("/Calendar"))
        {
            InvokeAsync(async () =>
            {
                await LoadDashboardSettings();
                
                // Refresh tasks widget to show new tasks
                if (tasksWidgetRendererRef != null)
                {
                    var tasksWidget = tasksWidgetRendererRef.GetTasksWidgetRef();
                    if (tasksWidget != null)
                    {
                        await tasksWidget.RefreshTasks();
                    }
                }
                
                StateHasChanged();
            });
        }
    }

    private async Task LoadDashboardSettings()
    {
        // Initialize default widgets based on user role
        widgets = GetDefaultWidgets(userRole);
        
        // TODO: Load user's saved dashboard settings from backend
        // This would integrate with a DashboardSettingsService
    }

    private List<WidgetInfo> GetDefaultWidgets(string role)
    {
        var defaultWidgets = new List<WidgetInfo>();

        // Relative brugere skal kun se Announcements widget
        if (role == "Relative")
        {
            defaultWidgets.Add(new WidgetInfo
            {
                Id = "announcements",
                Title = "Opslagstavle",
                Type = "Announcements",
                Position = 1,
                Size = 3,
                IsVisible = true,
                Role = "Relative"
            });
            return defaultWidgets.OrderBy(w => w.Position).ToList();
        }

        // Common widgets for all users (ikke Relative)
        defaultWidgets.Add(new WidgetInfo
        {
            Id = "tasks",
            Title = "Mine Opgaver",
            Type = "Tasks",
            Position = 1,
            Size = 2,
            IsVisible = true,
            Role = "All"
        });

        defaultWidgets.Add(new WidgetInfo
        {
            Id = "quickactions",
            Title = "Hurtige Handlinger",
            Type = "QuickActions",
            Position = 2,
            Size = 1,
            IsVisible = true,
            Role = "All"
        });

        defaultWidgets.Add(new WidgetInfo
        {
            Id = "activities",
            Title = "Aktiviteter",
            Type = "Activities",
            Position = 3,
            Size = 2,
            IsVisible = true,
            Role = "All"
        });

        // Role-specific widgets
        if (role == "Admin" || role == "Staff")
        {
            defaultWidgets.Add(new WidgetInfo
            {
                Id = "shifts",
                Title = "Vagtplan",
                Type = "Shifts",
                Position = 4,
                Size = 2,
                IsVisible = true,
                Role = "Staff"
            });

            // Notifications widget disabled until backend is ready
            // defaultWidgets.Add(new WidgetInfo
            // {
            //     Id = "notifications",
            //     Title = "Notifikationer",
            //     Type = "Notifications",
            //     Position = 5,
            //     Size = 1,
            //     IsVisible = true,
            //     Role = "Staff"
            // });
        }

        return defaultWidgets.OrderBy(w => w.Position).ToList();
    }

    private List<WidgetInfo> GetVisibleWidgets()
    {
        return widgets.Where(w => w.IsVisible).ToList();
    }

    private string GetWidgetSizeClass(int size)
    {
        return size switch
        {
            1 => "widget-small",
            2 => "widget-medium",
            3 => "widget-large",
            _ => "widget-small"
        };
    }

    private async Task OnWidgetClick(WidgetInfo widget)
    {
        if (isEditMode)
        {
            // Handle widget editing (resize, move, etc.)
            await HandleWidgetEdit(widget);
        }
        else
        {
            // Handle widget click (navigate to full page)
            await HandleWidgetNavigation(widget);
        }
    }

    private async Task HandleWidgetEdit(WidgetInfo widget)
    {
        // TODO: Implement widget editing logic
        // This could include resizing, moving, or configuring widgets
        // Widget editing functionality to be implemented
    }

    private async Task HandleWidgetNavigation(WidgetInfo widget)
    {
        var url = widget.Type switch
        {
            "Tasks" => "/tasks",
            "Shifts" => "/schedule",
            "Activities" => "/activities",
            "Notifications" => "/notifications",
            "Announcements" => "/announcements",
            _ => "/"
        };
        
        NavigationManager.NavigateTo(url);
    }

    private void ToggleEditMode()
    {
        isEditMode = !isEditMode;
    }

    private async Task ResetLayout()
    {
        widgets = GetDefaultWidgets(userRole);
        StateHasChanged();
        
        // TODO: Save reset layout to backend
    }

    // Drag and Drop Methods
    private void OnDragStart(WidgetInfo widget)
    {
        draggedWidget = widget;
    }

    private void OnDragEnter(WidgetInfo widget)
    {
        if (draggedWidget != null && draggedWidget != widget)
        {
            dragTargetWidget = widget;
        }
    }

    private void OnDragLeave()
    {
        dragTargetWidget = null;
    }

    private void OnDrop(WidgetInfo targetWidget)
    {
        if (draggedWidget != null && draggedWidget != targetWidget)
        {
            // Swap positions
            var draggedIndex = widgets.IndexOf(draggedWidget);
            var targetIndex = widgets.IndexOf(targetWidget);

            if (draggedIndex != -1 && targetIndex != -1)
            {
                var draggedPosition = draggedWidget.Position;
                draggedWidget.Position = targetWidget.Position;
                targetWidget.Position = draggedPosition;

                // Re-order widgets
                widgets = widgets.OrderBy(w => w.Position).ToList();
                StateHasChanged();
            }
        }

        // Reset drag state
        draggedWidget = null;
        dragTargetWidget = null;
    }

    public void Dispose()
    {
        welcomeTimer?.Dispose();
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}