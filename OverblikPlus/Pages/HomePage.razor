@page "/"
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Models.Dtos.Tasks
@using OverblikPlus.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject ITaskService TaskService
@inject ITaskStepService TaskStepService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@using System.Timers

<AuthorizeView>
    <Authorized>
        <!-- Dashboard for logged in users -->
        <div class="dashboard-container">
            @if (showWelcomeMessage)
            {
                <div class="welcome-section">
                    <h1 class="welcome-title">Velkommen tilbage, @AuthStateProvider.User?.FirstName!</h1>
                    <p class="welcome-subtitle">Her er dit daglige overblik</p>
                </div>
            }
            
            <div class="dashboard-controls">
                <select @bind="taskViewMode" class="view-selector">
                    <option value="Single">Én opgave ad gangen</option>
                    <option value="List">Listevisning</option>
                </select>
            </div>

            @if (taskViewMode == "Single")
            {
                <div class="task-card">
                    @if (uncompletedTasks.Count > 0)
                    {
                        var currentTask = uncompletedTasks[currentTaskIndex];
                        <div class="task-header">
                            <h3 class="task-title">@currentTask.Name</h3>
                            <div class="task-progress">
                                <span class="progress-text">@(currentTaskIndex + 1) af @uncompletedTasks.Count</span>
                            </div>
                        </div>
                        <div class="task-content">
                            @if (!string.IsNullOrEmpty(currentTask.Image))
                            {
                                <img src="@currentTask.Image" alt="Task Image" class="task-image" />
                            }
                            <p class="task-description">@currentTask.Description</p>
                            <div class="task-actions">
                                @if (currentTask.HasSteps)
                                {
                                    <button class="btn-primary" @onclick="() => GoToTaskSteps(currentTask.Id)">
                                        <i class="fas fa-list-ol me-2"></i>
                                        Gå til trin
                                    </button>
                                }
                                <button class="btn-secondary" @onclick="NextTask">
                                    <i class="fas fa-arrow-right me-2"></i>
                                    Næste opgave
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="no-tasks">
                            <i class="fas fa-check-circle"></i>
                            <h3>Alle opgaver er færdige!</h3>
                            <p>Du har ingen uløste opgaver for i dag. Godt klaret!</p>
                        </div>
                    }
                </div>
                <ChatMessages/>
            }
            else if (taskViewMode == "List")
            {
                <div class="task-list-container">
                    <div class="list-header">
                        <h3 class="list-title">Dagens opgaver</h3>
                        <div class="completion-stats">
                            <span class="stats-text">@todaysTasks.Count(t => t.IsCompleted) af @todaysTasks.Count færdige</span>
                        </div>
                    </div>
                    
                    <div class="progress-container">
                        <div class="progress-bar">
                            <div class="progress-fill" style="width: @(taskCompletionPercentage)%;"></div>
                        </div>
                        <span class="progress-percentage">@(taskCompletionPercentage)%</span>
                    </div>

                    <div class="task-list">
                        @foreach (var task in todaysTasks)
                        {
                            <div class="task-item @(task.IsCompleted ? "completed" : "")">
                                <div class="task-checkbox">
                                    <input
                                        type="checkbox"
                                        checked="@task.IsCompleted"
                                        @onchange="async (e) => await OnTaskStatusChanged(task.Id, ((ChangeEventArgs)e).Value is bool value && value)"/>
                                </div>
                                @if (!string.IsNullOrEmpty(task.Image))
                                {
                                    <img src="@task.Image" alt="Task Image" class="task-thumbnail" />
                                }
                                <div class="task-info">
                                    <span class="task-name">@task.Name</span>
                                    @if (!string.IsNullOrEmpty(task.Description))
                                    {
                                        <span class="task-desc">@task.Description</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Landing page for non-authenticated users -->
        <div class="landing-page">
            <div class="hero-section">
                <div class="hero-content">
                    <div class="logo-section">
                        <div class="logo-icon">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <h1 class="hero-title">OverblikPlus</h1>
                    </div>
                    <p class="hero-subtitle">Dit personlige overblik for et organiseret bosted</p>
                    <p class="hero-description">
                        Effektiv administration, kommunikation og opgavestyring samlet ét sted. 
                        Skab overblik og struktur for både beboere og personale.
                    </p>
                    <div class="hero-actions">
                        <a href="/login" class="btn-primary-large">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            Log ind
                        </a>
                        <a href="/create-user" class="btn-secondary-large">
                            <i class="fas fa-user-plus me-2"></i>
                            Opret konto
                        </a>
                    </div>
                </div>
                <div class="hero-visual">
                    <div class="feature-cards">
                        <div class="feature-card">
                            <i class="fas fa-tasks"></i>
                            <h4>Opgavestyring</h4>
                            <p>Organiser daglige opgaver og rutiner</p>
                        </div>
                        <div class="feature-card">
                            <i class="fas fa-users"></i>
                            <h4>Aktiviteter</h4>
                            <p>Planlæg og deltag i fælles aktiviteter</p>
                        </div>
                        <div class="feature-card">
                            <i class="fas fa-comments"></i>
                            <h4>Kommunikation</h4>
                            <p>Effektiv kommunikation mellem alle</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="features-section">
                <div class="container">
                    <h2 class="features-title">Hvorfor vælge OverblikPlus?</h2>
                    <div class="features-grid">
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fas fa-clock"></i>
                            </div>
                            <h3>Dagligt overblik</h3>
                            <p>Få et klart overblik over dagens opgaver og aktiviteter</p>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fas fa-mobile-alt"></i>
                            </div>
                            <h3>Altid tilgængelig</h3>
                            <p>Adgang til dit overblik på alle enheder, når som helst</p>
                        </div>
                        <div class="feature-item">
                            <div class="feature-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <h3>Sikker og privat</h3>
                            <p>Dine data er beskyttet med moderne sikkerhedsteknologi</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<ReadTaskDto> todaysTasks = new();
    private List<ReadTaskDto> uncompletedTasks => todaysTasks.Where(t => !t.IsCompleted).ToList();
    private int taskCompletionPercentage = 0;
    private string taskViewMode = "Single";
    private int currentTaskIndex = 0;
    private bool showWelcomeMessage = true;
    private Timer welcomeMessageTimer;

    protected override async Task OnInitializedAsync()
    {
        await RefreshTasks();
        StartWelcomeMessageTimer();
    }

    private async Task RefreshTasks()
    {
        try
        {
            var result = await TaskService.GetTasksForUserAsync(AuthStateProvider.User.Id);

            if (!result.Success)
            {
                Console.WriteLine($"Fejl ved hentning af opgaver: {result.Error}");
                todaysTasks = new List<ReadTaskDto>();
                return;
            }

            todaysTasks = FilterTasks(result.Data);

            currentTaskIndex = 0;
            UpdateProgress();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Uventet fejl i RefreshTasks: {ex.Message}");
            todaysTasks = new List<ReadTaskDto>();
        }
    }

    private static List<ReadTaskDto> FilterTasks(List<ReadTaskDto> tasks)
    {
        var today = DateTime.Today;

        return tasks.Where(task => IsTaskOccurringOnDate(task, today)).ToList();
    }
    
    private static bool IsTaskOccurringOnDate(ReadTaskDto task, DateTime selectedDate)
    {
        if (task.RecurrenceType == "None")
        {
            return task.StartDate.Date == selectedDate.Date;
        }
        
        if (!task.NextOccurrence.HasValue) return false;
        
        return task.RecurrenceType switch
        {
            "Daily" => IsDailyMatch(task, selectedDate),
            "Weekly" => IsWeeklyMatch(task, selectedDate),
            "Monthly" => IsMonthlyMatch(task, selectedDate),
            "Yearly" => IsYearlyMatch(task, selectedDate),
            _ => false
        };
    }
    
    private static bool IsDailyMatch(ReadTaskDto task, DateTime selectedDate)
    {
        var daysDiff = (selectedDate.Date - task.StartDate.Date).Days;
        return daysDiff >= 0 && daysDiff % task.RecurrenceInterval == 0;
    }
    
    private static bool IsWeeklyMatch(ReadTaskDto task, DateTime selectedDate)
    {
        var daysDiff = (selectedDate.Date - task.StartDate.Date).Days;
        return daysDiff >= 0 && daysDiff % (task.RecurrenceInterval * 7) == 0;
    }
    
    private static bool IsMonthlyMatch(ReadTaskDto task, DateTime selectedDate)
    {
        if (selectedDate.Date < task.StartDate.Date) return false;
        
        var monthsDiff = ((selectedDate.Year - task.StartDate.Year) * 12) + 
                         (selectedDate.Month - task.StartDate.Month);
        
        if (monthsDiff < 0 || monthsDiff % task.RecurrenceInterval != 0) 
            return false;
        
        // Tjek om dagen matcher baseret på monthly type
        return task.MonthlyType switch
        {
            "SameDay" => selectedDate.Day == task.StartDate.Day,
            "FirstDay" => selectedDate.Day == 1,
            "LastDay" => selectedDate.Day == DateTime.DaysInMonth(selectedDate.Year, selectedDate.Month),
            "SpecificDay" => selectedDate.Day == task.MonthlyDay,
            _ => false
        };
    }
    
    private static bool IsYearlyMatch(ReadTaskDto task, DateTime selectedDate)
    {
        if (selectedDate.Date < task.StartDate.Date) return false;
        
        var yearsDiff = selectedDate.Year - task.StartDate.Year;
        
        return yearsDiff >= 0 && yearsDiff % task.RecurrenceInterval == 0 && 
               selectedDate.Month == task.StartDate.Month && 
               selectedDate.Day == task.StartDate.Day;
    }

    private void UpdateProgress()
    {
        if (todaysTasks.Count > 0)
        {
            var completedTasks = todaysTasks.Count(t => t.IsCompleted);
            taskCompletionPercentage = (int)Math.Round((double)completedTasks / todaysTasks.Count * 100);
        }
        else
        {
            taskCompletionPercentage = 0;
        }

        StateHasChanged();
    }

    private async Task NextTask()
    {
        if (uncompletedTasks.Count == 0)
            return;

        currentTaskIndex = (currentTaskIndex + 1) % uncompletedTasks.Count;
        await Task.CompletedTask;
    }

    private async Task GoToTaskSteps(int taskId)
    {
        var steps = await TaskStepService.GetStepsForTask(taskId);
        if (steps != null && steps.Count > 0)
        {
            NavigationManager.NavigateTo($"/task-step-view/{taskId}/step/{steps.First().Id}");
        }
        else
        {
            Console.WriteLine($"No steps found for task {taskId}");
        }
    }

    private async Task OnTaskStatusChanged(int taskId, bool isCompleted)
    {
        if (isCompleted)
        {
            await TaskService.MarkTaskAsCompleted(taskId);
        }

        var task = todaysTasks.FirstOrDefault(t => t.Id == taskId);
        if (task != null)
        {
            task.IsCompleted = isCompleted;
            UpdateProgress();
        }
    }

    private void StartWelcomeMessageTimer()
    {
        welcomeMessageTimer = new Timer(5000); 
        welcomeMessageTimer.Elapsed += HideWelcomeMessage;
        welcomeMessageTimer.AutoReset = false;
        welcomeMessageTimer.Start();
    }

    private void HideWelcomeMessage(object sender, ElapsedEventArgs e)
    {
        showWelcomeMessage = false;
        InvokeAsync(StateHasChanged);
    }

}