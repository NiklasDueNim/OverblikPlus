@page "/user-list"
@using OverblikPlus.Models.Dtos.User
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.Components.Shared
@using OverblikPlus.Components
@using Microsoft.AspNetCore.Components
@inject IUserService UserService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inherits BasePage

<h3>Liste over brugere</h3>

<AlertMessage Message="@ErrorMessage" Type="AlertType.Error" MessageChanged="@((string? msg) => ErrorMessage = msg)" />
<AlertMessage Message="@SuccessMessage" Type="AlertType.Success" MessageChanged="@((string? msg) => SuccessMessage = msg)" />

@if (IsLoading)
{
    <LoadingSpinner Text="Indlæser brugere..." />
}
else if (users == null || !users.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>
        Ingen brugere fundet.
    </div>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Fornavn</th>
            <th>Efternavn</th>
            <th>Brugernavn</th>
            <th>Rolle</th>
            <th>Handlinger</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var user in users)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Username</td>
                <td>@user.Role</td>
                <td>
                    <button class="btn btn-primary btn-sm" @onclick="() => EditUser(user.Id)">Rediger</button>
                    <button class="btn btn-danger btn-sm ms-2" @onclick="() => DeleteUser(user.Id)">Slet</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<ConfirmDialog Show="@showDeleteConfirm" 
               Title="Slet bruger" 
               Message="Er du sikker på, at du vil slette denne bruger?" 
               ConfirmText="Slet" 
               OnConfirmed="ConfirmDeleteUser" 
               OnCancelled="CancelDeleteUser" />

@code {
    private IEnumerable<ReadUserDto>? users;
    private bool showDeleteConfirm = false;
    private string? userToDeleteId;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        SetLoading(true);
        ClearMessages();
        
        try
        {
            var result = await UserService.GetAllUsers();
            if (result.Success && result.Data != null)
            {
                users = result.Data;
                LogInfo($"Loaded {users.Count()} users.");
            }
            else
            {
                SetError(result.Error ?? "Kunne ikke hente brugere.");
                users = Enumerable.Empty<ReadUserDto>();
            }
        }
        catch (Exception ex)
        {
            LogError("Error loading users", ex);
            SetError("Kunne ikke hente brugere. Prøv igen senere.");
            users = Enumerable.Empty<ReadUserDto>();
        }
        finally
        {
            SetLoading(false);
        }
    }

    private void EditUser(string userId)
    {
        NavigationManager.NavigateTo($"/user/{userId}");
    }

    private async Task DeleteUser(string userId)
    {
        userToDeleteId = userId;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteUser()
    {
        if (string.IsNullOrEmpty(userToDeleteId))
            return;

        SetLoading(true);
        
        try
        {
            var result = await UserService.DeleteUser(userToDeleteId);
            if (result.Success)
            {
                SetSuccess("Brugeren er slettet.");
                await LoadUsers();
            }
            else
            {
                SetError(result.Error ?? "Kunne ikke slette brugeren.");
            }
        }
        catch (Exception ex)
        {
            LogError("Error deleting user", ex);
            SetError("Kunne ikke slette brugeren. Prøv igen senere.");
        }
        finally
        {
            SetLoading(false);
            showDeleteConfirm = false;
            userToDeleteId = null;
        }
    }

    private void CancelDeleteUser()
    {
        showDeleteConfirm = false;
        userToDeleteId = null;
    }
}