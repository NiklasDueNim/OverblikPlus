@page "/create-user"
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Models.Dtos.User
@using OverblikPlus.Services.Interfaces
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="create-user-page">
    <div class="create-user-container">
        <div class="create-user-header">
            <div class="logo-section">
                <div class="logo-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h1 class="create-user-title">Opret Bruger</h1>
            </div>
            <p class="create-user-subtitle">Opret en ny bruger til OverblikPlus systemet</p>
        </div>

        <div class="create-user-card">
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i>
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <EditForm Model="@newUser" OnValidSubmit="@HandleCreateUser" class="create-user-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="alert alert-danger" />

                <div class="form-row">
                    <div class="form-group">
                        <label for="firstName" class="form-label">
                            <i class="fas fa-user me-1"></i>
                            Fornavn *
                        </label>
                        <InputText id="firstName" @bind-Value="newUser.FirstName" class="form-control" placeholder="Indtast fornavn" />
                    </div>

                    <div class="form-group">
                        <label for="lastName" class="form-label">
                            <i class="fas fa-user me-1"></i>
                            Efternavn *
                        </label>
                        <InputText id="lastName" @bind-Value="newUser.LastName" class="form-control" placeholder="Indtast efternavn" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="email" class="form-label">
                        <i class="fas fa-envelope me-1"></i>
                        Email *
                    </label>
                    <InputText id="email" @bind-Value="newUser.Email" class="form-control" placeholder="Indtast email adresse" />
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">
                        <i class="fas fa-lock me-1"></i>
                        Adgangskode *
                    </label>
                    <InputText id="password" @bind-Value="newUser.Password" type="password" class="form-control" placeholder="Indtast adgangskode" />
                </div>

                @if (isAdmin)
                {
                    <div class="form-group">
                        <label for="role" class="form-label">
                            <i class="fas fa-user-tag me-1"></i>
                            Rolle
                        </label>
                        <InputSelect id="role" @bind-Value="newUser.Role" class="form-select">
                            <option value="Beboer">Beboer</option>
                            <option value="Medarbejder">Medarbejder</option>
                            <option value="Admin">Admin</option>
                            <option value="Relative">Relative</option>
                        </InputSelect>
                    </div>
                }

                <div class="form-actions">
                    <a href="/login" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>
                        Tilbage til login
                    </a>
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <text>Opretter bruger...</text>
                        }
                        else
                        {
                            <i class="fas fa-user-plus me-1"></i>
                            <text>Opret Bruger</text>
                        }
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private CreateUserDto newUser = new CreateUserDto();
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private bool isAdmin = false;
    private bool isSubmitting = false;

    [Inject] public IUserService UserService { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var role = await AuthStateProvider.GetRoleAsync();
        isAdmin = role is "Admin";
    }

    private async Task HandleCreateUser()
    {
        if (isSubmitting) return;
        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            if (string.IsNullOrEmpty(newUser.Role))
            {
                newUser.Role = "Beboer";
            }

            var result = await UserService.CreateUser(newUser);

            if (result.Success)
            {
                successMessage = "Bruger oprettet succesfuldt!";
                newUser = new CreateUserDto();
                
                // Redirect to login after 2 seconds
                await Task.Delay(2000);
                NavigationManager.NavigateTo("/login");
            }
            else
            {
                errorMessage = $"Fejl ved oprettelse af bruger: {result.Error}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Der opstod en uventet fejl: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}