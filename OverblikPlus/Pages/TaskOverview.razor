@page "/tasks"
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Models.Dtos.Tasks
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.Components
@using OverblikPlus.Components.Shared
@inherits BasePage
@inject ITaskService TaskService
@inject ITaskStepService TaskStepService
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="tasks-page">
    <h1 class="tasks-title">Dagens Opgaver</h1>

    <div class="date-nav">
        <button class="btn-day" @onclick="ShowPreviousDay" aria-label="Forrige dag">
            <i class="fas fa-chevron-left"></i>
        </button>
        <div class="date-nav-center">
            <span class="date-label">@SelectedDate.ToString("dddd d. MMMM yyyy")</span>
            @if (SelectedDate.Date != DateTime.Today)
            {
                <button class="btn-today" @onclick="GoToToday">I dag</button>
            }
        </div>
        <button class="btn-day" @onclick="ShowNextDay" aria-label="Næste dag">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>

    <AlertMessage Message="@ErrorMessage" Type="AlertType.Error" MessageChanged="@((string? msg) => ErrorMessage = msg)" />
    <AlertMessage Message="@SuccessMessage" Type="AlertType.Success" MessageChanged="@((string? msg) => SuccessMessage = msg)" />

    @if (FilteredTasks.Any())
    {
        <div class="progress-summary">
            <div class="progress-text">@CompletedCount af @TotalCount opgaver klaret</div>
            <div class="progress-track">
                <div class="progress-bar-fill" style="width:@ProgressPercent%"></div>
            </div>
        </div>
    }

    @if (IsLoading)
    {
        <LoadingSpinner Text="Henter opgaver..." />
    }
    else if (!FilteredTasks.Any())
    {
        <div class="empty-state">
            <i class="fas fa-mug-hot"></i>
            <h3>Ingen opgaver i dag</h3>
            <p>Der er ingen planlagte opgaver for denne dag.</p>
        </div>
    }
    else
    {
        <div class="task-cards">
            @foreach (var task in FilteredTasks)
            {
                <div class="task-card @(IsCompleted(task) ? "is-done" : "")">
                    <div class="task-card-media">
                        @if (!string.IsNullOrEmpty(task.Image))
                        {
                            <img src="@task.Image" alt="@task.Name" />
                        }
                        else
                        {
                            <i class="fas fa-list-check"></i>
                        }
                    </div>
                    <div class="task-card-body">
                        @if (HasTime(task))
                        {
                            <span class="task-time">
                                <i class="fas fa-clock"></i>
                                @task.StartTime.ToString("HH:mm")@(task.EndTime > task.StartTime ? $" – {task.EndTime:HH:mm}" : "")
                            </span>
                        }
                        <h2 class="task-name">@task.Name</h2>
                        @if (!string.IsNullOrEmpty(task.Description))
                        {
                            <p class="task-desc">@task.Description</p>
                        }
                    </div>
                    <div class="task-card-action">
                        @if (IsCompleted(task))
                        {
                            <span class="done-badge"><i class="fas fa-check"></i> Klaret</span>
                            <button class="btn-undo" disabled="@IsLoading" @onclick="() => UncompleteTask(task.Id)">Fortryd</button>
                        }
                        else if (task.HasSteps)
                        {
                            <button class="btn-start" @onclick="() => GoToTaskSteps(task.Id)">
                                <i class="fas fa-play me-1"></i> Start
                            </button>
                        }
                        else
                        {
                            <button class="btn-complete" disabled="@IsLoading" @onclick="() => CompleteTask(task.Id)">
                                <i class="fas fa-check me-1"></i> Markér som færdig
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ReadTaskDto> AllTasks { get; set; } = new();
    private List<ReadTaskDto> FilteredTasks { get; set; } = new();
    private DateTime SelectedDate { get; set; } = DateTime.Today;

    // Per-occurrence completion: set of (taskId, occurrenceDate) marked done.
    private HashSet<(int, DateTime)> _completed = new();

    private bool IsCompleted(ReadTaskDto task) => _completed.Contains((task.Id, SelectedDate.Date));

    private int CompletedCount => FilteredTasks.Count(IsCompleted);
    private int TotalCount => FilteredTasks.Count;
    private int ProgressPercent => TotalCount == 0 ? 0 : (int)Math.Round(100.0 * CompletedCount / TotalCount);

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
        await LoadCompletions();
        FilterTasksByDate();
    }

    private async Task LoadCompletions()
    {
        try
        {
            var userId = AuthStateProvider.GetUserId();
            if (string.IsNullOrEmpty(userId)) return;

            var from = DateTime.Today.AddDays(-120);
            var to = DateTime.Today.AddDays(400);
            var result = await TaskService.GetCompletions(userId, from, to);
            if (result.Success && result.Data != null)
            {
                _completed = result.Data
                    .Select(c => (c.TaskId, c.OccurrenceDate.Date))
                    .ToHashSet();
            }
        }
        catch (Exception ex)
        {
            LogError("Error loading completions", ex);
        }
    }

    private async Task LoadTasks()
    {
        SetLoading(true);
        ClearMessages();

        try
        {
            var userId = AuthStateProvider.GetUserId();
            if (string.IsNullOrEmpty(userId))
            {
                LogWarning("User ID is null or empty when loading tasks.");
                AllTasks = new List<ReadTaskDto>();
                return;
            }

            var result = await TaskService.GetTasksForUserAsync(userId);
            if (result.Success)
            {
                AllTasks = result.Data ?? new List<ReadTaskDto>();
                LogInfo($"Loaded {AllTasks.Count} tasks for user {userId}");
            }
            else
            {
                AllTasks = new List<ReadTaskDto>();
                SetError("Kunne ikke hente opgaver. Prøv igen senere.");
                LogError($"Error loading tasks: {result.Error}");
            }
        }
        catch (Exception ex)
        {
            AllTasks = new List<ReadTaskDto>();
            SetError("Der opstod en fejl ved hentning af opgaver.");
            LogError("Unexpected error loading tasks", ex);
        }
        finally
        {
            SetLoading(false);
        }
    }

    private async Task CompleteTask(int taskId)
    {
        SetLoading(true);
        ClearMessages();
        try
        {
            var result = await TaskService.MarkTaskAsCompleted(taskId, SelectedDate);
            if (result.Success)
            {
                _completed.Add((taskId, SelectedDate.Date));
                FilterTasksByDate();
            }
            else
            {
                SetError(result.Error ?? "Kunne ikke markere opgaven som færdig.");
            }
        }
        catch (Exception ex)
        {
            SetError("Der opstod en fejl. Prøv igen.");
            LogError("Error completing task", ex);
        }
        finally
        {
            SetLoading(false);
        }
    }

    private async Task UncompleteTask(int taskId)
    {
        SetLoading(true);
        ClearMessages();
        try
        {
            var result = await TaskService.MarkTaskAsUnCompleted(taskId, SelectedDate);
            if (result.Success)
            {
                _completed.Remove((taskId, SelectedDate.Date));
                FilterTasksByDate();
            }
            else
            {
                SetError(result.Error ?? "Kunne ikke fortryde.");
            }
        }
        catch (Exception ex)
        {
            SetError("Der opstod en fejl. Prøv igen.");
            LogError("Error uncompleting task", ex);
        }
        finally
        {
            SetLoading(false);
        }
    }

    private static bool HasTime(ReadTaskDto task) =>
        task.StartTime.TimeOfDay != TimeSpan.Zero || task.EndTime.TimeOfDay != TimeSpan.Zero;

    private void FilterTasksByDate()
    {
        FilteredTasks = AllTasks
            .Where(task => IsTaskOccurringOnDate(task, SelectedDate))
            .OrderBy(IsCompleted)
            .ThenBy(task => task.StartTime.TimeOfDay)
            .ToList();
    }

    // A task occurs on a date if it's a one-off on that day, or a recurring task whose
    // rule matches that day (within its end condition). Completion is tracked separately
    // per (taskId, date), so each occurrence is independent.
    private bool IsTaskOccurringOnDate(ReadTaskDto task, DateTime selectedDate)
    {
        var d = selectedDate.Date;
        if (d < task.StartDate.Date) return false;

        if (string.IsNullOrEmpty(task.RecurrenceType) || task.RecurrenceType == "None")
            return task.StartDate.Date == d;

        if (!PatternMatches(task, d)) return false;
        return WithinEnd(task, d);
    }

    private bool PatternMatches(ReadTaskDto task, DateTime d) => task.RecurrenceType switch
    {
        "Daily" => (d - task.StartDate.Date).Days % Math.Max(1, task.RecurrenceInterval) == 0,
        "Weekly" => IsWeeklyMatch(task, d),
        "Monthly" => IsMonthlyMatch(task, d),
        "Yearly" => IsYearlyMatch(task, d),
        _ => false
    };

    private bool IsWeeklyMatch(ReadTaskDto task, DateTime d)
    {
        var interval = Math.Max(1, task.RecurrenceInterval);
        var weeks = (StartOfWeek(d) - StartOfWeek(task.StartDate)).Days / 7;
        if (weeks % interval != 0) return false;

        var active = task.SelectedWeekDays?.Where(kv => kv.Value).Select(kv => kv.Key).ToList() ?? new List<string>();
        if (active.Count == 0) active.Add(DanishDay(task.StartDate.DayOfWeek));
        return active.Contains(DanishDay(d.DayOfWeek));
    }

    private bool IsMonthlyMatch(ReadTaskDto task, DateTime d)
    {
        var interval = Math.Max(1, task.RecurrenceInterval);
        var monthsDiff = ((d.Year - task.StartDate.Year) * 12) + (d.Month - task.StartDate.Month);
        if (monthsDiff < 0 || monthsDiff % interval != 0) return false;

        return task.MonthlyType switch
        {
            "FirstDay" => d.Day == 1,
            "LastDay" => d.Day == DateTime.DaysInMonth(d.Year, d.Month),
            "SpecificDay" => d.Day == Math.Min(task.MonthlyDay, DateTime.DaysInMonth(d.Year, d.Month)),
            _ => d.Day == Math.Min(task.StartDate.Day, DateTime.DaysInMonth(d.Year, d.Month))
        };
    }

    private bool IsYearlyMatch(ReadTaskDto task, DateTime d)
    {
        var interval = Math.Max(1, task.RecurrenceInterval);
        var yearsDiff = d.Year - task.StartDate.Year;
        return yearsDiff % interval == 0 && d.Month == task.StartDate.Month && d.Day == task.StartDate.Day;
    }

    private bool WithinEnd(ReadTaskDto task, DateTime d)
    {
        if (task.EndType == "Date")
            return !task.EndDate.HasValue || d <= task.EndDate.Value.Date;

        if (task.EndType == "After")
        {
            var count = 0;
            var cur = task.StartDate.Date;
            var guard = 0;
            while (cur <= d && guard++ < 4000)
            {
                if (PatternMatches(task, cur)) count++;
                cur = cur.AddDays(1);
            }
            return count <= Math.Max(1, task.EndAfterCount);
        }

        return true; // Never
    }

    private static DateTime StartOfWeek(DateTime d)
    {
        int diff = ((int)d.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return d.Date.AddDays(-diff);
    }

    private static string DanishDay(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Mandag",
        DayOfWeek.Tuesday => "Tirsdag",
        DayOfWeek.Wednesday => "Onsdag",
        DayOfWeek.Thursday => "Torsdag",
        DayOfWeek.Friday => "Fredag",
        DayOfWeek.Saturday => "Lørdag",
        _ => "Søndag"
    };

    private void ShowPreviousDay()
    {
        SelectedDate = SelectedDate.AddDays(-1);
        FilterTasksByDate();
    }

    private void ShowNextDay()
    {
        SelectedDate = SelectedDate.AddDays(1);
        FilterTasksByDate();
    }

    private void GoToToday()
    {
        SelectedDate = DateTime.Today;
        FilterTasksByDate();
    }

    private async Task GoToTaskSteps(int taskId)
    {
        var result = await TaskStepService.GetStepsForTask(taskId);
        if (result.Success && result.Data != null && result.Data.Count > 0)
        {
            NavigationManager.NavigateTo($"/task-step-view/{taskId}/step/{result.Data.First().Id}");
        }
        else
        {
            SetError("Denne opgave har ingen trin.");
        }
    }
}
