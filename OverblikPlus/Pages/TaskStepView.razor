@page "/task-step-view/{TaskId:int}/step/{StepId:int}"
@using OverblikPlus.Models.Dtos.TaskSteps
@using OverblikPlus.Services.Interfaces
@inject ITaskStepService TaskStepService
@inject ITaskService TaskService
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IDisposable

<div class="step-view">
    <div class="step-topbar">
        <button class="btn-exit" @onclick="ExitToTasks">
            <i class="fas fa-xmark"></i> Afslut
        </button>
        @if (currentStep != null && TaskSteps.Count > 0)
        {
            <span class="step-progress-text">Trin @(CurrentIndex + 1) af @TaskSteps.Count</span>
        }
    </div>

    @if (currentStep != null && TaskSteps.Count > 0)
    {
        <div class="step-progress-track">
            <div class="step-progress-fill" style="width:@ProgressPercent%"></div>
        </div>
    }

    @if (currentStep == null)
    {
        <p class="step-loading">Indlæser trin...</p>
    }
    else
    {
        <div class="step-card">
            @if (!string.IsNullOrEmpty(currentStep.Image))
            {
                <img src="@currentStep.Image" alt="Billede for trinnet" class="step-image" />
            }

            <div class="step-text-row">
                <p class="step-text">@currentStep.Text</p>
                <button class="btn-speak" @onclick="Speak" aria-label="Læs trinnet højt" title="Læs højt">
                    <i class="fas fa-volume-high"></i>
                </button>
            </div>

            @if (!string.IsNullOrEmpty(scanMessage))
            {
                <div class="alert alert-warning">@scanMessage</div>
            }

            @if (currentStep.RequiresQrCodeScan && isScanning)
            {
                <div id="qr-scanner" class="step-scanner">
                    <video id="video"></video>
                    <button class="btn-cancel-scan" @onclick="StopScanning">Annuller scanning</button>
                </div>
            }

            <div class="step-actions">
                <button class="btn-prev" disabled="@(CurrentIndex <= 0)" @onclick="PreviousStep">
                    <i class="fas fa-arrow-left"></i> Tilbage
                </button>

                @if (currentStep.RequiresQrCodeScan)
                {
                    @if (!isScanning)
                    {
                        <button class="btn-next" @onclick="StartScanning">
                            <i class="fas fa-qrcode"></i> Scan QR-kode
                        </button>
                    }
                }
                else
                {
                    <button class="btn-next" @onclick="ShowNextStep">
                        @if (IsLastStep)
                        {
                            <span><i class="fas fa-check"></i> Færdig</span>
                        }
                        else
                        {
                            <span>Næste <i class="fas fa-arrow-right"></i></span>
                        }
                    </button>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int TaskId { get; set; }
    [Parameter] public int StepId { get; set; }

    private List<ReadTaskStepDto> TaskSteps { get; set; } = new();
    private ReadTaskStepDto? currentStep;
    private bool isScanning = false;
    private string? scanMessage;
    private DotNetObjectReference<TaskStepView>? _objRef;

    private int CurrentIndex => TaskSteps.FindIndex(s => s.Id == StepId);
    private bool IsLastStep => CurrentIndex >= 0 && CurrentIndex == TaskSteps.Count - 1;
    private int ProgressPercent => TaskSteps.Count == 0
        ? 0
        : (int)Math.Round(100.0 * (CurrentIndex + 1) / TaskSteps.Count);

    protected override void OnInitialized()
    {
        _objRef = DotNetObjectReference.Create(this);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Steps are loaded once and reused as the user moves between them.
        if (TaskSteps.Count == 0)
        {
            await LoadSteps();
        }
        SetCurrentStep();
    }

    private async Task LoadSteps()
    {
        var result = await TaskStepService.GetStepsForTask(TaskId);
        TaskSteps = (result.Success && result.Data != null)
            ? result.Data
            : new List<ReadTaskStepDto>();

        for (int i = 0; i < TaskSteps.Count; i++)
        {
            TaskSteps[i].StepNumber = i + 1;
        }
    }

    private void SetCurrentStep()
    {
        scanMessage = null;
        currentStep = TaskSteps.FirstOrDefault(step => step.Id == StepId);

        if (currentStep == null && TaskSteps.Count > 0)
        {
            Navigation.NavigateTo("/tasks");
        }
    }

    private async Task ShowNextStep()
    {
        await Js.InvokeVoidAsync("stopSpeaking");

        if (CurrentIndex != -1 && CurrentIndex < TaskSteps.Count - 1)
        {
            var nextStepId = TaskSteps[CurrentIndex + 1].Id;
            Navigation.NavigateTo($"/task-step-view/{TaskId}/step/{nextStepId}");
        }
        else
        {
            await TaskService.MarkTaskAsCompleted(TaskId);
            Navigation.NavigateTo("/tasks");
        }
    }

    private async Task PreviousStep()
    {
        await Js.InvokeVoidAsync("stopSpeaking");

        if (CurrentIndex > 0)
        {
            var prevStepId = TaskSteps[CurrentIndex - 1].Id;
            Navigation.NavigateTo($"/task-step-view/{TaskId}/step/{prevStepId}");
        }
    }

    private async Task ExitToTasks()
    {
        await Js.InvokeVoidAsync("stopSpeaking");
        Navigation.NavigateTo("/tasks");
    }

    private async Task Speak()
    {
        if (currentStep != null && !string.IsNullOrWhiteSpace(currentStep.Text))
        {
            await Js.InvokeVoidAsync("speakText", currentStep.Text);
        }
    }

    public async Task StartScanning()
    {
        if (!isScanning)
        {
            scanMessage = null;
            isScanning = true;
            await Js.InvokeVoidAsync("startScanning", _objRef);
        }
    }

    public async Task StopScanning()
    {
        await Js.InvokeVoidAsync("stopScanning");
        isScanning = false;
    }

    [JSInvokable]
    public async Task OnQrCodeScanned(string result)
    {
        await StopScanning();

        if (string.IsNullOrWhiteSpace(result))
        {
            scanMessage = "Der blev ikke læst nogen kode. Prøv at scanne igen.";
            StateHasChanged();
            return;
        }

        await ShowNextStep();
    }

    public void Dispose()
    {
        _ = Js.InvokeVoidAsync("stopSpeaking");
        _objRef?.Dispose();
    }
}
