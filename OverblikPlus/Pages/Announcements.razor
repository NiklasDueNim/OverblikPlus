@page "/announcements"
@using OverblikPlus.Models.Dtos.Announcement
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Components.Shared
@using OverblikPlus.Components
@using OverblikPlus.Components.Dashboard
@using OverblikPlus.Constants
@inject IAnnouncementService AnnouncementService
@inject CustomAuthStateProvider AuthStateProvider
@inherits BasePage

<div class="announcements-page">
    <div class="ann-header">
        <h1 class="ann-title">Opslagstavle</h1>
        @if (!IsRelative())
        {
            <button class="btn-new-ann" @onclick="OpenCreateModal">
                <i class="fas fa-plus me-1"></i> Nyt opslag
            </button>
        }
    </div>

    <AlertMessage Message="@ErrorMessage" Type="AlertType.Error" MessageChanged="@((string? msg) => ErrorMessage = msg)" />
    <AlertMessage Message="@SuccessMessage" Type="AlertType.Success" MessageChanged="@((string? msg) => SuccessMessage = msg)" />

    @if (IsLoading)
    {
        <LoadingSpinner Text="Henter opslag..." />
    }
    else if (VisibleAnnouncements.Count == 0)
    {
        <div class="ann-empty">
            <i class="fas fa-clipboard"></i>
            <h3>Ingen opslag</h3>
            <p>Der er ingen aktive opslag lige nu.</p>
        </div>
    }
    else
    {
        <div class="ann-list">
            @foreach (var ann in VisibleAnnouncements)
            {
                <div class="ann-card @(ann.IsImportant ? "important" : "")">
                    <div class="ann-card-head">
                        <h2 class="ann-card-title">@ann.Title</h2>
                        @if (ann.IsImportant)
                        {
                            <span class="ann-badge"><i class="fas fa-exclamation-circle me-1"></i>Vigtigt</span>
                        }
                    </div>
                    <p class="ann-card-body">@ann.Body</p>
                    <div class="ann-card-foot">
                        <span class="ann-dates">
                            <i class="fas fa-calendar-day me-1"></i>
                            @ann.StartDate.ToString("dd. MMM") – @ann.EndDate.ToString("dd. MMM yyyy")
                        </span>
                        @if (!IsRelative())
                        {
                            <span class="ann-actions">
                                <button class="ann-btn-edit" @onclick="() => OpenEditModal(ann)">Rediger</button>
                                <button class="ann-btn-del" @onclick="() => DeleteAnnouncement(ann.Id)">Slet</button>
                            </span>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<Modal Show="@showModal" 
       ShowChanged="@((bool show) => showModal = show)"
       Title="@(isEditMode ? "Rediger opslag" : "Opret nyt opslag")"
       PrimaryButtonText="@(isEditMode ? "Gem" : "Opret")"
       OnPrimaryAction="HandleSaveAnnouncement"
       OnClose="CloseModal">
    <BodyContent>
        <label>Titel:</label>
        <input type="text" class="form-control" @bind="currentAnnouncement.Title" />
        <label>Tekst:</label>
        <textarea class="form-control" @bind="currentAnnouncement.Body"></textarea>
        <label>Start dato:</label>
        <input type="date" class="form-control" @bind="currentAnnouncement.StartDate" />
        <label>Slut dato:</label>
        <input type="date" class="form-control" @bind="currentAnnouncement.EndDate" />
        <div class="form-check mt-2">
            <input type="checkbox" class="form-check-input" id="chkImportant" @bind="currentAnnouncement.IsImportant" />
            <label class="form-check-label" for="chkImportant">Vigtigt opslag?</label>
        </div>
    </BodyContent>
</Modal>

@code {
    private List<AnnouncementDto> announcements = new();
    private bool showModal = false;
    private bool isEditMode = false;
    private AnnouncementDto currentAnnouncement = new();
    private bool showDeleteConfirm = false;
    private Guid? announcementToDeleteId;

    private List<AnnouncementDto> VisibleAnnouncements =>
        (announcements ?? new())
            .Where(a => DateTime.Today >= a.StartDate && DateTime.Today <= a.EndDate)
            .OrderByDescending(a => a.IsImportant)
            .ThenByDescending(a => a.StartDate)
            .ToList();

    private bool IsRelative()
    {
        return AuthStateProvider.User?.IsRelative ?? false;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAnnouncements();
    }

    private async Task LoadAnnouncements()
    {
        SetLoading(true);
        ClearMessages();
        
        try
        {
            announcements = await AnnouncementService.GetAllAsync();
            LogInfo($"Loaded {announcements.Count} announcements");
        }
        catch (Exception ex)
        {
            LogError("Error loading announcements", ex);
            SetError("Kunne ikke hente opslag. Prøv igen senere.");
        }
        finally
        {
            SetLoading(false);
        }
    }

    private void OpenCreateModal()
    {
        showModal = true;
        isEditMode = false;
        currentAnnouncement = new AnnouncementDto 
        { 
            StartDate = DateTime.Today, 
            EndDate = DateTime.Today.AddDays(7) 
        };
    }

    private void OpenEditModal(AnnouncementDto ann)
    {
        showModal = true;
        isEditMode = true;
        currentAnnouncement = new AnnouncementDto
        {
            Id = ann.Id,
            Title = ann.Title,
            Body = ann.Body,
            StartDate = ann.StartDate,
            EndDate = ann.EndDate,
            IsImportant = ann.IsImportant
        };
    }

    private async Task CreateAnnouncement()
    {
        SetLoading(true);
        ClearMessages();
        
        try
        {
            await AnnouncementService.CreateAsync(currentAnnouncement);
            SetSuccess("Opslaget er oprettet.");
            await LoadAnnouncements();
            showModal = false;
        }
        catch (Exception ex)
        {
            LogError("Error creating announcement", ex);
            SetError("Kunne ikke oprette opslag. Prøv igen senere.");
        }
        finally
        {
            SetLoading(false);
        }
    }

    private async Task UpdateAnnouncement()
    {
        SetLoading(true);
        ClearMessages();
        
        try
        {
            await AnnouncementService.UpdateAsync(currentAnnouncement);
            SetSuccess("Opslaget er opdateret.");
            await LoadAnnouncements();
            showModal = false;
        }
        catch (Exception ex)
        {
            LogError("Error updating announcement", ex);
            SetError("Kunne ikke opdatere opslag. Prøv igen senere.");
        }
        finally
        {
            SetLoading(false);
        }
    }

    private void DeleteAnnouncement(Guid id)
    {
        announcementToDeleteId = id;
        showDeleteConfirm = true;
    }

    private async Task ConfirmDeleteAnnouncement()
    {
        if (!announcementToDeleteId.HasValue)
            return;

        SetLoading(true);
        
        try
        {
            await AnnouncementService.DeleteAsync(announcementToDeleteId.Value);
            SetSuccess("Opslaget er slettet.");
            await LoadAnnouncements();
        }
        catch (Exception ex)
        {
            LogError("Error deleting announcement", ex);
            SetError("Kunne ikke slette opslag. Prøv igen senere.");
        }
        finally
        {
            SetLoading(false);
            showDeleteConfirm = false;
            announcementToDeleteId = null;
        }
    }

    private void CancelDeleteAnnouncement()
    {
        showDeleteConfirm = false;
        announcementToDeleteId = null;
    }

    private async Task ReloadAnnouncements()
    {
        await LoadAnnouncements();
    }

    private void CloseModal()
    {
        showModal = false;
        currentAnnouncement = new AnnouncementDto();
        isEditMode = false;
    }

    private async Task HandleSaveAnnouncement()
    {
        if (isEditMode)
        {
            await UpdateAnnouncement();
        }
        else
        {
            await CreateAnnouncement();
        }
    }
}

<ConfirmDialog Show="@showDeleteConfirm" 
               Title="Slet opslag" 
               Message="Er du sikker på, at du vil slette dette opslag?" 
               ConfirmText="Slet" 
               OnConfirmed="ConfirmDeleteAnnouncement" 
               OnCancelled="CancelDeleteAnnouncement" />
