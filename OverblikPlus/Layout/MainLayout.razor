@using OverblikPlus.AuthHelpers
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.Components.Dashboard
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthStateProvider

<!-- Desktop Sidebar -->
<AuthorizeView>
    <Authorized>
        <div class="desktop-menu-bar">
            <div class="sidebar-logo">
                <img src="/images/logo-blue.png" alt="OverblikPlus Logo" />
                <h2>OverblikPlus</h2>
            </div>
            @if (!IsRelative())
            {
                <NavLink href="/" Match="NavLinkMatch.All">
                    <span class="icon"><i class="fas fa-house"></i></span>
                    <span>Hjem</span>
                </NavLink>
                <NavLink href="/tasks">
                    <span class="icon"><i class="fas fa-list-check"></i></span>
                    <span>Dagens Opgaver</span>
                </NavLink>
                <NavLink href="/scan">
                    <span class="icon"><i class="fas fa-qrcode"></i></span>
                    <span>Scan QR-kode</span>
                </NavLink>
                <NavLink href="/TaskManager">
                    <span class="icon"><i class="fas fa-square-plus"></i></span>
                    <span>Opret Opgaver</span>
                </NavLink>
                <NavLink href="/calendar">
                    <span class="icon"><i class="fas fa-calendar-days"></i></span>
                    <span>Kalender</span>
                </NavLink>
                <NavLink href="/chatTest">
                    <span class="icon"><i class="fas fa-comments"></i></span>
                    <span>Beskeder</span>
                </NavLink>
                <NavLink href="/budget">
                    <span class="icon"><i class="fas fa-wallet"></i></span>
                    <span>Budget</span>
                </NavLink>
                <NavLink href="/mood">
                    <span class="icon"><i class="fas fa-face-smile"></i></span>
                    <span>Mit humør</span>
                </NavLink>
                @if (IsAdminOrStaff())
                {
                    <NavLink href="/mood-overview">
                        <span class="icon"><i class="fas fa-chart-line"></i></span>
                        <span>Humør Oversigt</span>
                    </NavLink>
                }
                <NavLink href="/schedule">
                    <span class="icon"><i class="fas fa-user-clock"></i></span>
                    <span>Vagtskema</span>
                </NavLink>
                <NavLink href="/activities">
                    <span class="icon"><i class="fas fa-people-group"></i></span>
                    <span>Aktiviteter</span>
                </NavLink>
            }
            <NavLink href="/announcements">
                <span class="icon"><i class="fas fa-bullhorn"></i></span>
                <span>Opslagstavle</span>
            </NavLink>
            @* Notifications disabled until backend is ready *@
            @* <div class="notification-bell-wrapper">
                <NotificationBell />
            </div> *@
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Desktop menu hidden for non-authenticated users - they use the landing page -->
    </NotAuthorized>
</AuthorizeView>

<!-- Mobile Bottom Navigation -->
<AuthorizeView>
    <Authorized>
        <div class="mobile-menu-bar">
            @if (!IsRelative())
            {
                <NavLink href="/" Match="NavLinkMatch.All">
                    <span class="icon"><i class="fas fa-house"></i></span>
                    <span class="label">Hjem</span>
                </NavLink>
                <NavLink href="/tasks">
                    <span class="icon"><i class="fas fa-list-check"></i></span>
                    <span class="label">Opgaver</span>
                </NavLink>
                <NavLink href="/scan">
                    <span class="icon"><i class="fas fa-qrcode"></i></span>
                    <span class="label">Scan</span>
                </NavLink>
                <NavLink href="/TaskManager">
                    <span class="icon"><i class="fas fa-square-plus"></i></span>
                    <span class="label">Opret</span>
                </NavLink>
                <NavLink href="/calendar">
                    <span class="icon"><i class="fas fa-calendar-days"></i></span>
                    <span class="label">Kalender</span>
                </NavLink>
            }
            <NavLink href="/announcements">
                <span class="icon"><i class="fas fa-bullhorn"></i></span>
                <span class="label">Opslag</span>
            </NavLink>
            @if (IsAdminOrStaff())
            {
                <NavLink href="/mood-overview">
                    <span class="icon"><i class="fas fa-chart-line"></i></span>
                    <span class="label">Humør</span>
                </NavLink>
            }
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Mobile menu hidden for non-authenticated users - they use the landing page -->
    </NotAuthorized>
</AuthorizeView>

<!-- Main Content -->
<AuthorizeView>
    <Authorized>
        <div class="content-wrapper authenticated">
            <article class="content">
                @Body
            </article>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="content-wrapper">
            <article class="content">
                @Body
            </article>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    protected override async Task OnInitializedAsync()
    {
    }

    // Removed OnAfterRenderAsync - using CSS for scrolling instead

    private bool IsRelative()
    {
        if(AuthStateProvider.User == null)
        {
            return false;
        }

        return AuthStateProvider.User.IsRelative;
    }

    private bool IsAdminOrStaff()
    {
        if (AuthStateProvider.User == null)
        {
            return false;
        }

        var role = AuthStateProvider.GetRole();
        return role == "Admin" || role == "Staff";
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}