@using OverblikPlus.AuthHelpers
@using OverblikPlus.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject CustomAuthStateProvider AuthStateProvider

<!-- Desktop Sidebar -->
<AuthorizeView>
    <Authorized>
        <div class="desktop-menu-bar">
            <a href="/">
                <span class="icon">🏠</span>
                <span>Hjem</span>
            </a>
            <a href="/tasks">
                <span class="icon">📋</span>
                <span>Dagens Opgaver</span>
            </a>
            <a href="/scan">
                <span class="icon">📷</span>
                <span>Scan QR-kode</span>
            </a>
            <a href="/TaskManager">
                <span class="icon">➕</span>
                <span>Opret Opgaver</span>
            </a>
            <a href="/calendar">
                <span class="icon">📅</span>
                <span>Kalender</span>
            </a>
            <a href="/chatTest">
                <span class="icon">✉️</span>
                <span>Beskeder</span>
            </a>
            <a href="/announcements">
                <span class="icon">🧑‍🏫</span>
                <span>Opslagstavle</span>
            </a>
            <a href="/budget">
                <span class="icon">💰</span>
                <span>Budget</span>
            </a>
            <a href="/mood">
                <span class="icon">😎</span>
                <span>Mit humør</span>
            </a>
            <a href="/schedule">
                <span class="icon">😎</span>
                <span>Vagtskema</span>
            </a>
            <a href="/activities">
                <span class="icon">😎</span>
                <span>Aktiviteter</span>
            </a>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Desktop menu hidden for non-authenticated users - they use the landing page -->
    </NotAuthorized>
</AuthorizeView>

<!-- Mobile Bottom Navigation -->
<AuthorizeView>
    <Authorized>
        <div class="mobile-menu-bar">
            <a href="/">
                <span class="icon">🏠</span>
                <span class="label">Hjem</span>
            </a>
            <a href="/tasks">
                <span class="icon">📋</span>
                <span class="label">Opgaver</span>
            </a>
            <a href="/scan">
                <span class="icon">📷</span>
                <span class="label">Scan</span>
            </a>
            <a href="/TaskManager">
                <span class="icon">➕</span>
                <span class="label">Opret</span>
            </a>
            <a href="/calendar">
                <span class="icon">📅</span>
                <span class="label">Kalender</span>
            </a>
        </div>
    </Authorized>
    <NotAuthorized>
        <!-- Mobile menu hidden for non-authenticated users - they use the landing page -->
    </NotAuthorized>
</AuthorizeView>

<!-- Main Content -->
<div class="content-wrapper">
    <article class="content">
        @Body
    </article>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login");
    }
}