@* Widget renderer component - renders appropriate widget based on type *@
@using OverblikPlus.Models.Dashboard

@if (Widget.Type == "Tasks")
{
    <TasksWidget @ref="tasksWidgetRef" WidgetInfo="Widget" OnWidgetClicked="OnWidgetClicked" />
}
else if (Widget.Type == "Shifts")
{
    <ShiftsWidget WidgetInfo="Widget" OnWidgetClicked="OnWidgetClicked" />
}
else if (Widget.Type == "Activities")
{
    <ActivitiesWidget WidgetInfo="Widget" OnWidgetClicked="OnWidgetClicked" />
}
else if (Widget.Type == "QuickActions")
{
    <QuickActionsWidget WidgetInfo="Widget" OnWidgetClicked="OnWidgetClicked" />
}
else if (Widget.Type == "Notifications")
{
    <NotificationsWidget WidgetInfo="Widget" OnWidgetClicked="OnWidgetClicked" />
}
else
{
    <div class="widget-shortcut">
        <div class="widget-shortcut-icon">
            <i class="fas @IconFor(Widget.Type)"></i>
        </div>
        <h4>@Widget.Title</h4>
        <p>@DescriptionFor(Widget.Type)</p>
    </div>
}

@code {
    [Parameter] public WidgetInfo Widget { get; set; } = default!;
    [Parameter] public EventCallback<WidgetInfo> OnWidgetClicked { get; set; }

    private TasksWidget? tasksWidgetRef;

    public TasksWidget? GetTasksWidgetRef() => tasksWidgetRef;

    private static string IconFor(string type) => type switch
    {
        "Announcements" => "fa-bullhorn",
        "Calendar" => "fa-calendar-days",
        "Mood" => "fa-face-smile",
        "Budget" => "fa-coins",
        "Messages" => "fa-comments",
        _ => "fa-square"
    };

    private static string DescriptionFor(string type) => type switch
    {
        "Announcements" => "Klik for at se alle opslag",
        "Calendar" => "Klik for at se kalenderen",
        "Mood" => "Klik for at registrere dit humør",
        "Budget" => "Klik for at se budgettet",
        "Messages" => "Klik for at åbne beskeder",
        _ => "Klik for at åbne"
    };
}

