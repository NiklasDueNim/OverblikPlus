@using OverblikPlus.Models.Dashboard
@using OverblikPlus.Models.Dtos.Tasks
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.AuthHelpers
@inject ITaskService TaskService
@inject CustomAuthStateProvider AuthStateProvider

<BaseWidget WidgetInfo="@WidgetInfo" OnWidgetClicked="@OnWidgetClicked">
    @if (isLoading)
    {
        <div class="widget-loading">
            <div class="spinner-border spinner-border-sm" role="status">
                <span class="sr-only">Henter opgaver...</span>
            </div>
            <span class="ms-2">Henter opgaver...</span>
        </div>
    }
    else if (todaysTasks.Any())
    {
        <div class="tasks-summary">
            <div class="tasks-stats">
                <div class="stat-item">
                    <span class="stat-number">@todaysTasks.Count</span>
                    <span class="stat-label">I alt</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number completed">@completedTasks</span>
                    <span class="stat-label">Færdige</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number pending">@pendingTasks</span>
                    <span class="stat-label">Venter</span>
                </div>
            </div>
            
            <div class="progress-container">
                <div class="progress">
                    <div class="progress-bar" style="width: @(completionPercentage)%"></div>
                </div>
                <span class="progress-text">@(completionPercentage)% færdig</span>
            </div>

            <div class="widget-controls">
                <label class="toggle-images">
                    <input type="checkbox" @bind="showImages" @onclick:stopPropagation="true" />
                    <span>Vis billeder</span>
                </label>
            </div>

            <div class="tasks-list">
                @foreach (var task in todaysTasks.Take(ShowNumberOfTasks))
                {
                    <div class="task-item @(task.IsCompleted ? "completed" : "")">
                        <div class="task-checkbox">
                            <input type="checkbox" checked="@task.IsCompleted" @onchange="@(() => ToggleTask(task))" @onclick:stopPropagation="true"/>
                        </div>
                        @if (showImages && !string.IsNullOrEmpty(task.Image))
                        {
                            <div class="task-image">
                                <img src="@task.Image" alt="@task.Name" />
                            </div>
                        }
                        <div class="task-info">
                            <span class="task-name">@task.Name</span>
                            @if (!string.IsNullOrEmpty(task.Description))
                            {
                                <span class="task-desc">@task.Description</span>
                            }
                        </div>
                    </div>
                }
                @if (todaysTasks.Count > ShowNumberOfTasks)
                {
                    <div class="more-tasks">
                        <a href="/tasks" class="btn btn-sm btn-outline-primary">
                            Se alle @(todaysTasks.Count - ShowNumberOfTasks) flere opgaver
                        </a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="no-tasks">
            <i class="fas fa-check-circle text-success"></i>
            <p>Ingen opgaver!</p>
            <a href="/TaskManager" class="btn btn-sm btn-primary">Opret opgave</a>
        </div>
    }
</BaseWidget>

@code {
    [Parameter] public WidgetInfo WidgetInfo { get; set; } = new();
    [Parameter] public EventCallback<WidgetInfo> OnWidgetClicked { get; set; }

    private List<ReadTaskDto> todaysTasks = new();
    private bool isLoading = true;
    private bool showImages = false;
    private int completedTasks => todaysTasks.Count(t => t.IsCompleted);
    private int pendingTasks => todaysTasks.Count(t => !t.IsCompleted);
    private int completionPercentage => todaysTasks.Any() ? (int)((double)completedTasks / todaysTasks.Count * 100) : 0;
    private const int ShowNumberOfTasks = 9;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        try
        {
            isLoading = true;
            
            var userId = AuthStateProvider.GetUserIdAsync();
            if (!string.IsNullOrEmpty(userId))
            {
                var result = await TaskService.GetTasksForUserAsync(userId);
                if (result.Success)
                {
                    var allTasks = result.Data ?? new List<ReadTaskDto>();
                    Console.WriteLine($"✅ Successfully loaded {allTasks.Count} tasks for user {userId}");
                    
                    // Show all tasks (not just today's) for better visibility
                    todaysTasks = allTasks.ToList();
                    
                    // Sort by StartDate (most recent first)
                    todaysTasks = todaysTasks.OrderBy(t => t.StartDate).ToList();
                    
                    Console.WriteLine($"📋 Showing {todaysTasks.Count} total tasks");
                }
                else
                {
                    Console.WriteLine($"❌ Error loading tasks: {result.Error}");
                    todaysTasks = new List<ReadTaskDto>();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tasks: {ex.Message}");
            todaysTasks = new List<ReadTaskDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    
    public async Task RefreshTasks()
    {
        Console.WriteLine("🔄 Refreshing tasks widget...");
        await LoadTasks();
        Console.WriteLine($"✅ Tasks widget refreshed. Showing {todaysTasks.Count} tasks");
    }

    private async Task ToggleTask(ReadTaskDto task)
    {
        try
        {
            if (task.IsCompleted)
            {
                var result = await TaskService.MarkTaskAsUnCompleted(task.Id);
                if (result.Success)
                {
                    StateHasChanged();
                }
            }
            else
            {
               var result =  await TaskService.MarkTaskAsCompleted(task.Id);
               if (result.Success)
               {
                   StateHasChanged();
               }
            }
    }
    catch (Exception ex)
        {
            Console.WriteLine($"Error toggling task: {ex.Message}");
        }
    }
}
