@using OverblikPlus.Models.Dashboard
@using OverblikPlus.Models.Dtos.Tasks
@using OverblikPlus.Services.Interfaces
@using OverblikPlus.AuthHelpers
@using OverblikPlus.Common
@inject ITaskService TaskService
@inject CustomAuthStateProvider AuthStateProvider

<BaseWidget WidgetInfo="@WidgetInfo" OnWidgetClicked="@OnWidgetClicked">
    @if (isLoading)
    {
        <div class="widget-loading">
            <div class="spinner-border spinner-border-sm" role="status">
                <span class="sr-only">Henter opgaver...</span>
            </div>
            <span class="ms-2">Henter opgaver...</span>
        </div>
    }
    else if (todaysTasks.Any())
    {
        <div class="tasks-summary">
            <div class="tasks-stats">
                <div class="stat-item">
                    <span class="stat-number">@todaysTasks.Count</span>
                    <span class="stat-label">I alt</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number completed">@completedTasks</span>
                    <span class="stat-label">Færdige</span>
                </div>
                <div class="stat-item">
                    <span class="stat-number pending">@pendingTasks</span>
                    <span class="stat-label">Venter</span>
                </div>
            </div>
            
            <div class="progress-container">
                <div class="progress">
                    <div class="progress-bar" style="width: @(completionPercentage)%"></div>
                </div>
                <span class="progress-text">@(completionPercentage)% færdig</span>
            </div>

            <div class="widget-controls">
                <label class="toggle-images">
                    <input type="checkbox" @bind="showImages" @onclick:stopPropagation="true" />
                    <span>Vis billeder</span>
                </label>
            </div>

            <div class="tasks-list">
                @foreach (var task in todaysTasks.Take(ShowNumberOfTasks))
                {
                    <div class="task-item @(task.IsCompleted ? "completed" : "")">
                        <div class="task-checkbox">
                            <input type="checkbox" checked="@task.IsCompleted" @onchange="@((ChangeEventArgs e) => HandleCheckboxChange(e, task))" @onclick:stopPropagation="true"/>
                        </div>
                        @if (showImages && !string.IsNullOrEmpty(task.Image))
                        {
                            <div class="task-image">
                                <img src="@task.Image" alt="@task.Name" />
                            </div>
                        }
                        <div class="task-info">
                            <span class="task-name">@task.Name</span>
                            @if (!string.IsNullOrEmpty(task.Description))
                            {
                                <span class="task-desc">@task.Description</span>
                            }
                        </div>
                    </div>
                }
                @if (todaysTasks.Count > ShowNumberOfTasks)
                {
                    <div class="more-tasks">
                        <a href="/tasks" class="btn btn-sm btn-outline-primary">
                            Se alle @(todaysTasks.Count - ShowNumberOfTasks) flere opgaver
                        </a>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="no-tasks">
            <i class="fas fa-check-circle text-success"></i>
            <p>Ingen opgaver!</p>
            <a href="/TaskManager" class="btn btn-sm btn-primary">Opret opgave</a>
        </div>
    }
</BaseWidget>

@code {
    [Parameter] public WidgetInfo WidgetInfo { get; set; } = new();
    [Parameter] public EventCallback<WidgetInfo> OnWidgetClicked { get; set; }

    private List<ReadTaskDto> todaysTasks = new();
    private bool isLoading = true;
    private bool showImages = false;
    private int completedTasks => todaysTasks.Count(t => t.IsCompleted);
    private int pendingTasks => todaysTasks.Count(t => !t.IsCompleted);
    private int completionPercentage => todaysTasks.Any() ? (int)((double)completedTasks / todaysTasks.Count * 100) : 0;
    private const int ShowNumberOfTasks = 9;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        try
        {
            isLoading = true;
            
            var userId = AuthStateProvider.GetUserIdAsync();
            if (!string.IsNullOrEmpty(userId))
            {
                var result = await TaskService.GetTasksForUserAsync(userId);
                if (result.Success)
                {
                    var allTasks = result.Data ?? new List<ReadTaskDto>();
                    Console.WriteLine($"✅ Successfully loaded {allTasks.Count} tasks for user {userId}");
                    
                    // Debug: Log alle opgaver
                    foreach (var task in allTasks)
                    {
                        Console.WriteLine($"  Task: {task.Name}, NextOccurrence: {task.NextOccurrence?.ToString("yyyy-MM-dd") ?? "null"}, Completed: {task.IsCompleted}, RecurrenceType: {task.RecurrenceType}");
                    }
                    
                    // Filtrer opgaver: Vis opgaver med NextOccurrence i dag eller fremtiden (eller null)
                    // For gentagende opgaver med samme navn og samme NextOccurrence dato: Vis kun én
                    var today = DateTime.Today;
                    var filteredTasks = allTasks
                        .Where(t => 
                        {
                            // Hvis NextOccurrence er null, vis den alligevel (kan være en engangsopgave)
                            if (!t.NextOccurrence.HasValue)
                            {
                                Console.WriteLine($"  Including task '{t.Name}' (NextOccurrence: null)");
                                return true;
                            }
                            
                            var nextOccurrenceDate = t.NextOccurrence.Value.Date;
                            
                            // Filtrer væk alle opgaver fra fortiden (uanset om de er færdige eller ej)
                            if (nextOccurrenceDate < today)
                            {
                                Console.WriteLine($"  Filtering out task '{t.Name}' (NextOccurrence: {nextOccurrenceDate:yyyy-MM-dd} is in the past, Completed: {t.IsCompleted})");
                                return false;
                            }
                            
                            // Vis alle opgaver i dag eller fremtiden
                            Console.WriteLine($"  Including task '{t.Name}' (NextOccurrence: {nextOccurrenceDate:yyyy-MM-dd}, Completed: {t.IsCompleted})");
                            return true;
                        })
                        .GroupBy(t => 
                        {
                            // Grupper på SeriesId hvis det findes, ellers brug Id som fallback (for bagudkompatibilitet)
                            // Dette sikrer at hver opgave har et unikt key, selv hvis SeriesId mangler
                            return t.SeriesId.HasValue && t.SeriesId.Value > 0 ? $"S:{t.SeriesId}" : $"N:{t.Name}_{t.Id}";
                        })
                        .Select(group => 
                        {
                            // For hver gruppe (samme serie eller navn), vælg den bedste opgave:
                            // Først: dedup indenfor gruppen - vælg én pr. dato (keep lowest Id)
                            var tasks = group
                                .GroupBy(t => t.NextOccurrence?.Date ?? DateTime.MaxValue.Date)
                                .Select(g => g.OrderBy(x => x.Id).First())
                                .ToList();
                            
                            Console.WriteLine($"  Group '{group.Key}': {tasks.Count} tasks");
                            
                            // 1. Først: Ikke færdig med NextOccurrence i dag
                            var activeToday = tasks.FirstOrDefault(t => !t.IsCompleted && 
                                t.NextOccurrence.HasValue && 
                                t.NextOccurrence.Value.Date == today);
                            if (activeToday != null)
                            {
                                Console.WriteLine($"    Selected: Active today task (ID: {activeToday.Id})");
                                return activeToday;
                            }
                            
                            // 2. Eller: Ikke færdig med NextOccurrence i fremtiden (nærmeste)
                            var activeFuture = tasks
                                .Where(t => !t.IsCompleted && 
                                    t.NextOccurrence.HasValue && 
                                    t.NextOccurrence.Value.Date > today)
                                .OrderBy(t => t.NextOccurrence)
                                .FirstOrDefault();
                            if (activeFuture != null)
                            {
                                Console.WriteLine($"    Selected: Active future task (ID: {activeFuture.Id}, NextOccurrence: {activeFuture.NextOccurrence.Value.Date:yyyy-MM-dd})");
                                return activeFuture;
                            }
                            
                            // 3. Eller: Færdig med NextOccurrence i dag
                            var completedToday = tasks.FirstOrDefault(t => t.IsCompleted && 
                                t.NextOccurrence.HasValue && 
                                t.NextOccurrence.Value.Date == today);
                            if (completedToday != null)
                            {
                                Console.WriteLine($"    Selected: Completed today task (ID: {completedToday.Id})");
                                return completedToday;
                            }
                            
                            // 4. Eller: Den nærmeste fremtidige (selvom færdig) - men kun hvis der ikke er nogen ikke-færdige
                            var nearestFuture = tasks
                                .Where(t => t.NextOccurrence.HasValue && 
                                    t.NextOccurrence.Value.Date >= today)
                                .OrderBy(t => t.NextOccurrence)
                                .FirstOrDefault();
                            if (nearestFuture != null)
                            {
                                Console.WriteLine($"    Selected: Nearest future task (ID: {nearestFuture.Id}, NextOccurrence: {nearestFuture.NextOccurrence.Value.Date:yyyy-MM-dd}, Completed: {nearestFuture.IsCompleted})");
                                return nearestFuture;
                            }
                            
                            // 5. Eller: Den første (hvis ingen matcher)
                            var first = tasks.First();
                            Console.WriteLine($"    Selected: First task (ID: {first.Id})");
                            return first;
                        })
                        .ToList();
                    
                    todaysTasks = filteredTasks;
                    
                    // Sort by NextOccurrence (earliest first), null values last
                    todaysTasks = todaysTasks.OrderBy(t => t.NextOccurrence ?? DateTime.MaxValue).ToList();
                    
                    Console.WriteLine($"📋 Filtered tasks: {todaysTasks.Count} (from {allTasks.Count} total)");
                    foreach (var task in todaysTasks)
                    {
                        Console.WriteLine($"  - {task.Name} (NextOccurrence: {task.NextOccurrence?.ToString("yyyy-MM-dd") ?? "null"}, Completed: {task.IsCompleted})");
                    }
                    
                    Console.WriteLine($"📋 Showing {todaysTasks.Count} filtered tasks (from {allTasks.Count} total)");
                }
                else
                {
                    Console.WriteLine($"❌ Error loading tasks: {result.Error}");
                    todaysTasks = new List<ReadTaskDto>();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading tasks: {ex.Message}");
            todaysTasks = new List<ReadTaskDto>();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    
    public async Task RefreshTasks()
    {
        Console.WriteLine("🔄 Refreshing tasks widget...");
        await LoadTasks();
        Console.WriteLine($"✅ Tasks widget refreshed. Showing {todaysTasks.Count} tasks");
    }

    private async Task HandleCheckboxChange(ChangeEventArgs e, ReadTaskDto task)
    {
        // Kald ToggleTask direkte
        await ToggleTask(task);
    }

    private async Task ToggleTask(ReadTaskDto task)
    {
        try
        {
            // Opdater lokalt først for at give øjeblikkelig feedback
            var wasCompleted = task.IsCompleted;
            var taskId = task.Id;
            var taskName = task.Name;
            var nextOccurrence = task.NextOccurrence?.ToString("yyyy-MM-dd") ?? "null";
            
            Console.WriteLine($"🔄 Toggling task {taskId} ({taskName}, NextOccurrence: {nextOccurrence}) from {(wasCompleted ? "completed" : "uncompleted")} to {(wasCompleted ? "uncompleted" : "completed")}");
            
            task.IsCompleted = !wasCompleted;
            StateHasChanged(); // Opdater UI med det samme
            
            Result result;
            if (wasCompleted)
            {
                Console.WriteLine($"  Calling MarkTaskAsUnCompleted for task {taskId}");
                result = await TaskService.MarkTaskAsUnCompleted(taskId);
            }
            else
            {
                Console.WriteLine($"  Calling MarkTaskAsCompleted for task {taskId}");
                result = await TaskService.MarkTaskAsCompleted(taskId);
            }
            
            Console.WriteLine($"  API result: Success={result.Success}, Error={result.Error}");
            
                if (result.Success)
                {
                Console.WriteLine($"✅ Task {taskId} ({taskName}) marked as {(wasCompleted ? "uncompleted" : "completed")}");
                // Refresh tasks to get updated list (inkl. eventuelle nye opgaver)
                await LoadTasks();
            }
            else
            {
                // Revert hvis det fejler
                task.IsCompleted = wasCompleted;
                Console.WriteLine($"❌ Failed to {(wasCompleted ? "uncomplete" : "complete")} task: {result.Error}");
                   StateHasChanged();
            }
    }
    catch (Exception ex)
        {
            Console.WriteLine($"❌ Exception toggling task: {ex.Message}");
            Console.WriteLine($"   Stack trace: {ex.StackTrace}");
            // Revert hvis der er en exception
            task.IsCompleted = !task.IsCompleted;
            StateHasChanged();
        }
    }
}
