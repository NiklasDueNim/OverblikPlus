@using OverblikPlus.AuthHelpers
@using OverblikPlus.Models.Dtos.User
@using OverblikPlus.Models.FormModels
@inject CustomAuthStateProvider AuthStateProvider

<div class="card mb-4">
    <div class="card-header">
        <h4 class="card-title">@Title</h4>
    </div>
    <div class="card-body">
        <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="mb-3">
                <label for="taskName" class="form-label">Navn:</label>
                <input id="taskName" @bind="Task.Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label for="taskDescription" class="form-label">Beskrivelse:</label>
                <textarea id="taskDescription" @bind="Task.Description" class="form-control"></textarea>
            </div>
            <div class="mb-3">
                <label for="taskImage" class="form-label">Billede:</label>
                <InputFile OnChange="HandleImageUpload" class="form-control" />
            </div>

            @if (isAdminOrStaff)
            {
                <div class="mb-3">
                    <label for="user" class="form-label">Tildel opgave til en bruger</label>
                    <select id="user" @bind="Task.UserId" class="form-select">
                        <option value="">Vælg bruger</option>
                        @foreach (var user in Users)
                        {
                            <option value="@user.Id">@user.FirstName @user.LastName</option>
                        }
                    </select>
                </div>
            }

            <div class="mb-3">
                <label for="startDate" class="form-label">Startdato:</label>
                <input id="startDate" type="date" @bind="Task.StartDate" class="form-control" />
            </div>

            <div class="mb-3">
                <label for="recurrenceType" class="form-label">Gentagelse:</label>
                <select id="recurrenceType" class="form-select" @bind="Task.RecurrenceType">
                    <option value="None">Ingen gentagelse (engangsopgave)</option>
                    <option value="Daily">Daglig</option>
                    <option value="Weekly">Ugentlig</option>
                    <option value="Monthly">Månedlig</option>
                    <option value="Yearly">Årlig</option>
                </select>
            </div>

            @if (Task.RecurrenceType == "Daily")
            {
                <div class="mb-3 rec-row">
                    <span>Hver</span>
                    <input type="number" @bind="Task.RecurrenceInterval" class="form-control rec-num" min="1" max="365" />
                    <span>@(Task.RecurrenceInterval == 1 ? "dag" : "dage")</span>
                </div>
            }

            @if (Task.RecurrenceType == "Weekly")
            {
                <div class="mb-3">
                    <label class="form-label">På disse dage:</label>
                    <div class="weekday-pills">
                        @foreach (var day in WeekDayOrder)
                        {
                            <button type="button"
                                    class="weekday-pill @(IsDaySelected(day) ? "active" : "")"
                                    @onclick="@(() => ToggleDay(day))">
                                @day.Substring(0, 3)
                            </button>
                        }
                    </div>
                    @if (!WeekDayOrder.Any(IsDaySelected))
                    {
                        <small class="rec-hint">Ingen dag valgt – bruger startdatoens ugedag (@DanishDay(Task.StartDate.DayOfWeek)).</small>
                    }
                </div>
                <div class="mb-3 rec-row">
                    <span>Hver</span>
                    <input type="number" @bind="Task.RecurrenceInterval" class="form-control rec-num" min="1" max="52" />
                    <span>@(Task.RecurrenceInterval == 1 ? "uge" : "uger")</span>
                </div>
            }

            @if (Task.RecurrenceType == "Monthly")
            {
                <div class="mb-3">
                    <label class="form-label">Månedlig:</label>
                    <select class="form-select" @bind="Task.MonthlyType">
                        <option value="SameDay">Samme dato (den @Task.StartDate.Day.)</option>
                        <option value="FirstDay">Første dag i måneden</option>
                        <option value="LastDay">Sidste dag i måneden</option>
                        <option value="SpecificDay">Bestemt dato</option>
                    </select>
                </div>
                @if (Task.MonthlyType == "SpecificDay")
                {
                    <div class="mb-3">
                        <label class="form-label">Dato i måneden:</label>
                        <select class="form-select rec-num" @bind="Task.MonthlyDay">
                            @for (int i = 1; i <= 31; i++)
                            {
                                <option value="@i">@i.</option>
                            }
                        </select>
                    </div>
                }
                <div class="mb-3 rec-row">
                    <span>Hver</span>
                    <input type="number" @bind="Task.RecurrenceInterval" class="form-control rec-num" min="1" max="24" />
                    <span>@(Task.RecurrenceInterval == 1 ? "måned" : "måneder")</span>
                </div>
            }

            @if (Task.RecurrenceType == "Yearly")
            {
                <div class="mb-3 rec-row">
                    <span>Hver</span>
                    <input type="number" @bind="Task.RecurrenceInterval" class="form-control rec-num" min="1" max="10" />
                    <span>år</span>
                </div>
            }

            @if (Task.RecurrenceType != "None")
            {
                <div class="mb-3">
                    <label class="form-label">Gentag indtil:</label>
                    <div class="end-options">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="endType" id="neverEnd"
                                   @onchange="@(() => Task.EndType = "Never")"
                                   checked="@(Task.EndType == "Never")" />
                            <label class="form-check-label" for="neverEnd">Aldrig</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="endType" id="endAfter"
                                   @onchange="@(() => Task.EndType = "After")"
                                   checked="@(Task.EndType == "After")" />
                            <label class="form-check-label" for="endAfter">
                                Efter
                                <input type="number" @bind="Task.EndAfterCount" class="form-control rec-num"
                                       min="1" max="999" />
                                gange
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="endType" id="endOnDate"
                                   @onchange="@(() => Task.EndType = "Date")"
                                   checked="@(Task.EndType == "Date")" />
                            <label class="form-check-label" for="endOnDate">
                                På dato
                                <input type="date" @bind="Task.EndDate" class="form-control rec-date" />
                            </label>
                        </div>
                    </div>
                </div>
            }

            <div class="rec-summary">
                <i class="fas fa-circle-info"></i>
                <span>@RecurrenceSummary</span>
            </div>

            @if (Task.RecurrenceType != "None")
            {
                <div class="mb-3">
                    <label class="form-label">Næste gentagelser:</label>
                    <div class="rec-preview">
                        @foreach (var occurrence in GetNextOccurrences(6))
                        {
                            <span class="rec-badge">@occurrence.ToString("ddd d. MMM")</span>
                        }
                    </div>
                </div>
            }

            <div class="d-flex justify-content-end">
                <button type="button" class="btn btn-primary me-2" @onclick="Save">Gem</button>
                <button type="button" class="btn btn-secondary" @onclick="Cancel">Annuller</button>
            </div>
        </form>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; }
    [Parameter] public TaskFormModel Task { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public List<ReadUserDto> Users { get; set; }
    private bool isAdminOrStaff;

    private static readonly string[] WeekDayOrder =
        { "Mandag", "Tirsdag", "Onsdag", "Torsdag", "Fredag", "Lørdag", "Søndag" };

    private readonly Dictionary<string, bool> weekDays = new()
    {
        {"Mandag", false}, {"Tirsdag", false}, {"Onsdag", false},
        {"Torsdag", false}, {"Fredag", false}, {"Lørdag", false}, {"Søndag", false}
    };

    protected override async Task OnInitializedAsync() => await InitializeForm();

    protected override async Task OnParametersSetAsync()
    {
        await InitializeForm();
        await base.OnParametersSetAsync();
    }

    private async Task InitializeForm()
    {
        var role = AuthStateProvider.GetRole();
        isAdminOrStaff = role == "Admin" || role == "Staff";

        if (Task == null)
        {
            Task = new TaskFormModel();
        }

        if (string.IsNullOrEmpty(Task.RecurrenceType))
        {
            Task.RecurrenceType = "None";
            Task.RecurrenceInterval = 1;
            Task.StartDate = DateTime.Now;
            Task.MonthlyType = "SameDay";
            Task.MonthlyDay = 1;
            Task.EndType = "Never";
            Task.EndAfterCount = 1;
        }

        if (Task.SelectedWeekDays == null || !Task.SelectedWeekDays.Any())
        {
            Task.SelectedWeekDays = new Dictionary<string, bool>(weekDays);
        }
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        if (e.FileCount > 0)
        {
            var file = e.File;
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var buffer = new byte[file.Size];
            await stream.ReadAsync(buffer);
            Task.ImageBase64 = Convert.ToBase64String(buffer);
        }
    }

    // ---- Weekday helpers ----
    private bool IsDaySelected(string day) =>
        Task.SelectedWeekDays != null && Task.SelectedWeekDays.TryGetValue(day, out var v) && v;

    private void ToggleDay(string day)
    {
        Task.SelectedWeekDays ??= new Dictionary<string, bool>();
        Task.SelectedWeekDays[day] = !IsDaySelected(day);
    }

    private List<string> ActiveWeekDays()
    {
        var days = WeekDayOrder.Where(IsDaySelected).ToList();
        if (days.Count == 0)
        {
            days.Add(DanishDay(Task.StartDate.DayOfWeek));
        }
        return days;
    }

    private static string DanishDay(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "Mandag",
        DayOfWeek.Tuesday => "Tirsdag",
        DayOfWeek.Wednesday => "Onsdag",
        DayOfWeek.Thursday => "Torsdag",
        DayOfWeek.Friday => "Fredag",
        DayOfWeek.Saturday => "Lørdag",
        _ => "Søndag"
    };

    private static DateTime StartOfWeek(DateTime d)
    {
        int diff = ((int)d.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
        return d.Date.AddDays(-diff);
    }

    private bool IsWeeklyOccurrence(DateTime date)
    {
        if (date.Date < Task.StartDate.Date) return false;
        var interval = Math.Max(1, Task.RecurrenceInterval);
        var weeks = (StartOfWeek(date) - StartOfWeek(Task.StartDate)).Days / 7;
        if (weeks < 0 || weeks % interval != 0) return false;
        return ActiveWeekDays().Contains(DanishDay(date.DayOfWeek));
    }

    // ---- Preview ----
    private List<DateTime> GetNextOccurrences(int count)
    {
        var occurrences = new List<DateTime>();

        if (Task.RecurrenceType == "None" || string.IsNullOrEmpty(Task.RecurrenceType))
        {
            if (Task.StartDate != default) occurrences.Add(Task.StartDate);
            return occurrences;
        }

        var maxDate = DateTime.Now.AddYears(2);

        if (Task.RecurrenceType == "Weekly")
        {
            var d = Task.StartDate.Date;
            while (occurrences.Count < count && d <= maxDate)
            {
                if (IsWeeklyOccurrence(d)) occurrences.Add(d);
                d = d.AddDays(1);
            }
            return occurrences;
        }

        var currentDate = Task.StartDate;
        for (int i = 0; i < count; i++)
        {
            var nextDate = Task.RecurrenceType switch
            {
                "Daily" => currentDate.AddDays(Math.Max(1, Task.RecurrenceInterval)),
                "Monthly" => CalculateMonthlyOccurrence(currentDate, Math.Max(1, Task.RecurrenceInterval), Task.MonthlyType, Task.MonthlyDay),
                "Yearly" => currentDate.AddYears(Math.Max(1, Task.RecurrenceInterval)),
                _ => currentDate
            };

            if (nextDate > maxDate) break;
            if (nextDate <= currentDate && i > 0) break;

            occurrences.Add(nextDate);
            currentDate = nextDate;
        }

        return occurrences;
    }

    private DateTime CalculateMonthlyOccurrence(DateTime startDate, int interval, string monthlyType, int monthlyDay)
    {
        var nextDate = startDate.AddMonths(interval);
        return monthlyType switch
        {
            "SameDay" => nextDate,
            "FirstDay" => new DateTime(nextDate.Year, nextDate.Month, 1),
            "LastDay" => new DateTime(nextDate.Year, nextDate.Month, 1).AddMonths(1).AddDays(-1),
            "SpecificDay" => GetSpecificDayInMonth(nextDate, monthlyDay),
            _ => nextDate
        };
    }

    private DateTime GetSpecificDayInMonth(DateTime month, int day)
    {
        var daysInMonth = DateTime.DaysInMonth(month.Year, month.Month);
        return new DateTime(month.Year, month.Month, Math.Min(day, daysInMonth));
    }

    // ---- Human-readable summary ----
    private string RecurrenceSummary
    {
        get
        {
            var start = Task.StartDate.ToString("d. MMMM yyyy");
            if (string.IsNullOrEmpty(Task.RecurrenceType) || Task.RecurrenceType == "None")
            {
                return $"Engangsopgave den {start}.";
            }

            var interval = Math.Max(1, Task.RecurrenceInterval);
            var core = Task.RecurrenceType switch
            {
                "Daily" => interval == 1 ? "Gentages hver dag" : $"Gentages hver {interval}. dag",
                "Weekly" => (interval == 1 ? "Gentages hver uge" : $"Gentages hver {interval}. uge")
                            + " på " + string.Join(", ", ActiveWeekDays().Select(d => d.ToLower())),
                "Monthly" => "Gentages " + MonthlyText() + (interval == 1 ? " hver måned" : $" hver {interval}. måned"),
                "Yearly" => interval == 1
                    ? $"Gentages hvert år den {Task.StartDate:d. MMMM}"
                    : $"Gentages hvert {interval}. år den {Task.StartDate:d. MMMM}",
                _ => ""
            };

            var end = Task.EndType switch
            {
                "After" => $", {Task.EndAfterCount} gange",
                "Date" => Task.EndDate.HasValue ? $", indtil {Task.EndDate:d. MMMM yyyy}" : "",
                _ => ""
            };

            return $"{core}{end}. Starter {start}.";
        }
    }

    private string MonthlyText() => Task.MonthlyType switch
    {
        "FirstDay" => "den 1.",
        "LastDay" => "den sidste dag",
        "SpecificDay" => $"den {Task.MonthlyDay}.",
        _ => $"den {Task.StartDate.Day}."
    };

    private async Task HandleSubmit() => await Save();
    private async Task Save() => await OnSave.InvokeAsync();
    private async Task Cancel() => await OnCancel.InvokeAsync();
}
